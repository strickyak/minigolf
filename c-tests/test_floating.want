--- Sizeof ---
sizeof: 5
--- FromWord and ToWord ---
w0: 0.0 0
w1: 1.0 1
w10: 10.0 10
w42: 42.0 42
w1000: 1000.0 1000
wMax: 65535.0 65535
--- FromInt and ToInt ---
i0: 0.0 0
i1: 1.0 1
iNeg1: -1.0 -1
i42: 42.0 42
iNeg42: -42.0 -42
iPosMax: 32767.0 32767
iNegMax: -32767.0 -32767
--- Addition ---
1 + 2 = 3.0
10 + 20 = 30.0
5 + (-3) = 2.0
(-5) + 3 = -2.0
(-5) + (-3) = -8.0
5 + (-5) = 0.0
--- Subtraction ---
5 - 3 = 2.0
3 - 5 = -2.0
5 - (-3) = 8.0
(-5) - 3 = -8.0
5 - 5 = 0.0
--- Multiplication and Division ---
2 * 3 = 6.0
10 / 4 = 2.5
1 / 8 = 0.125
--- Scanner and Formatter ---
scan 0.0 = 0.0
scan 1.0 = 1.0
scan 12.5 = 12.5
scan -3.75 = -3.75
scan 0.125 = 0.125
scan 42 = 42.0
scan 1.5e2 = 150.0
scan 1.5e-1 = 0.15
--- Operations with Scanned Numbers ---
1.25 + 2.5 = 3.75
2.5 - 1.25 = 1.25
1.25 * 2.5 = 3.125
2.5 / 1.25 = 2.0
