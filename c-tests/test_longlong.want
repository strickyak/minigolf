--- Constants and Conversions ---
zero: 0 is_zero=1
one: 1
w42: 42 to_word=42
wMax: 65535
iNeg1: -1
iNeg42: -42
fromLong: 2000000000
fromLongNeg: -2000000000
toLong: 2000000000
toLongNeg: -2000000000
--- FromString and Format ---
s1: 123456789012345678
sNeg1: -987654321098765432
maxPos: 9223372036854775807
minNeg: -9223372036854775808
--- Addition ---
1000000000000 + 2345678000000 = 3345678000000
5 + (-3) = 2
(-5) + 3 = -2
(-5) + (-3) = -8
5 + (-5) = 0
maxPos + 1 = -9223372036854775808
--- Subtraction ---
2345678000000 - 1000000000000 = 1345678000000
5 - 10 = -5
(-5) - 3 = -8
(-5) - (-5) = 0
--- Multiplication ---
12345678 * 87654321 = 1082152022374638
(-12345678) * 87654321 = -1082152022374638
(-12345678) * (-87654321) = 1082152022374638
0 * 12345678 = 0
(-1) * (-1) = 1
--- Division and Modulo ---
1000000000000000 / 7 = 142857142857142
1000000000000000 % 7 = 6
(-1000000000000000) / 7 = -142857142857142
(-1000000000000000) % 7 = -6
1000000000000000 / (-7) = -142857142857142
1000000000000000 % (-7) = 6
--- Comparisons ---
10 cmp 20: -1
20 cmp 20: 0
20 cmp 10: 1
(-10) cmp 10: -1
10 lt 20: 1
20 gt 10: 1
10 eq 10: 1
--- Bitwise and Shifts ---
h1 & h2 in hex: 34007800ab00ef
h1 | h2 in hex: 12ff56ff90ffcdff
h1 ^ h2 in hex: 12cb56879054cd10
1 << 40 = 1099511627776
(1 << 40) >> 40 = 1
(-1024) >> 2 = -256
ALL LONGLONG TESTS PASSED
