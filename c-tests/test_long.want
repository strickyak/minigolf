--- Constants and Conversions ---
zero: 0 is_zero=1
one: 1
w42: 42 to_word=42
wMax: 65535
iNeg1: -1
iNeg42: -42
--- FromString and Format ---
s1: 123456789
sNeg1: -987654321
maxPos: 2147483647
minNeg: -2147483648
--- Addition ---
1000000 + 2345678 = 3345678
5 + (-3) = 2
(-5) + 3 = -2
(-5) + (-3) = -8
5 + (-5) = 0
maxPos + 1 = -2147483648
--- Subtraction ---
2345678 - 1000000 = 1345678
5 - 10 = -5
(-5) - 3 = -8
(-5) - (-5) = 0
--- Multiplication ---
12345 * 6789 = 83810205
(-12345) * 6789 = -83810205
(-12345) * (-6789) = 83810205
0 * 12345 = 0
(-1) * (-1) = 1
--- Division and Modulo ---
1000000 / 3 = 333333
1000000 % 3 = 1
(-1000000) / 3 = -333333
(-1000000) % 3 = -1
1000000 / (-3) = -333333
1000000 % (-3) = 1
--- Comparisons ---
10 cmp 20: -1
20 cmp 20: 0
20 cmp 10: 1
(-10) cmp 10: -1
10 lt 20: 1
20 gt 10: 1
10 eq 10: 1
--- Bitwise and Shifts ---
h1 & h2 in hex: 340078
h1 | h2 in hex: 12ff56ff
h1 ^ h2 in hex: 12cb5687
1 << 10 = 1024
1024 >> 10 = 1
(-1024) >> 2 = -256
