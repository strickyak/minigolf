--- Constants ---
Pi: 3.141592
PiOverTwo: 1.570796
Tau: 6.283185
--- Sqrt Zero and One ---
sqrt(0) = 0.0
sqrt(1) = 1.0
--- Sqrt Exact Squares ---
sqrt(4) = 2.0
sqrt(9) = 3.0
sqrt(16) = 4.0
sqrt(25) = 5.0
sqrt(100) = 10.0
--- Sqrt Fractions ---
sqrt(0.25) = 0.5
sqrt(0.0625) = 0.25
--- Sqrt Irrational ---
sqrt(2) = 1.414213
--- Hypot ---
hypot(3, 4) = 5.0
--- Trigonometry ---
sin(0) = 0.0 cos(0) = 1.0
sin(pi/2) = 1.0 cos(pi/2) = 0.0
sin(pi) = 0.0 cos(pi) = -1.0
--- Atan and Atan2 ---
atan(0) = 0.0
atan(1) = 0.785398
atan2(0, 1) = 0.0
atan2(1, 0) = 1.570796
atan2(0, -1) = 3.141592
atan2(-1, 0) = -1.570796
