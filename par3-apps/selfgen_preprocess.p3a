; ====================================================================
; Function: get_arg
; ====================================================================
.function get_arg
    .param args_base: word
    .param idx: word
    .local addr: word
    .local res: slice
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; addr := args_base + idx * 6
    LOAD_LOCAL args_base
    LOAD_LOCAL idx
    PUSH_I8 6
    MUL
    ADD
    STORE_LOCAL addr
; var res
; res.Base = peek(addr)
    LOAD_LOCAL addr
    PEEK2
    ADDR_OF_LOCAL res
    SWAP
    POKE2
; res.Cap = peek(addr + 2)
    LOAD_LOCAL addr
    PUSH_I8 2
    ADD
    PEEK2
    ADDR_OF_LOCAL res
    PUSH_I16 2
    ADD
    SWAP
    POKE2
; res.Len = peek(addr + 4)
    LOAD_LOCAL addr
    PUSH_I8 4
    ADD
    PEEK2
    ADDR_OF_LOCAL res
    PUSH_I16 4
    ADD
    SWAP
    POKE2
; return res
    LOAD_LOCAL res
    RET_SLICE
    RET_VOID
.endfunction

