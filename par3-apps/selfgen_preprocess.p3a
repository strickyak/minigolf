    PUSH_I16 2
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    SWAP
    POKE2
; num_protected++
    LOAD_GLOBAL num_protected
    PUSH_1
    ADD
    STORE_GLOBAL num_protected
.L_endif_171:
    RET_VOID
.endfunction

