// -----------------------------------------------------------------------------
// Symbol Table Queries and Optimizations
// -----------------------------------------------------------------------------

func find_global(name string) word {
    return map_get(global_map, name)
}

func find_func(name string) word {
    return map_get(func_map, name)
}

func find_var_slot(name string) word {
    for i := word(0); i < num_cur_vars; i++ {
        if fn_var_names[i] == name {
            return word(fn_var_slots[i])
        }
    }
    if len(name) > 0 && name[0] >= '0' && name[0] <= '9' {
        return parse_int_val(name)
    }
    return 0xFFFF
}

func find_label(name string) word {
    lid := parse_label_id(name)
    if lid < MAX_LABELS {
        return label_offsets[lid]
    }
    return 0xFFFF
}

func try_optimize_local(m string, op string) word {
    if m == "LOAD_LOCAL" || m == "STORE_LOCAL" {
        slot := find_var_slot(op)
        if slot <= 3 {
            if m == "LOAD_LOCAL" {
                return 0x20 + slot
            } else {
                return 0x24 + slot
            }
        }
    }
    return 0xFFFF
}

func finalize_entry_func() {
    if len(pending_entry_name) > 0 {
        idx := find_func(pending_entry_name)
        if idx != 0xFFFF {
            entry_func_idx = idx
            return
        }
    }
    if entry_func_idx != 0xFFFF {
        return
    }
    for i := word(0); i < num_funcs; i++ {
        if func_names[i] == "main" || func_names[i] == "_start" || func_names[i] == "entry" {
            entry_func_idx = i
            return
        }
    }
    if num_funcs > 0 {
        entry_func_idx = 0
    } else {
        entry_func_idx = 0
    }
}

// -----------------------------------------------------------------------------
// Binary Output Buffering
// -----------------------------------------------------------------------------

func bin_write_byte(b byte) {
    if bin_buf_len >= 256 {
        bin_flush()
    }
    bin_buf[bin_buf_len] = b
    bin_buf_len++
}

func bin_write_word(w word) {
    bin_write_byte(byte(w >> 8))
    bin_write_byte(byte(w & 255))
}

func bin_flush() {
    if bin_buf_len > 0 {
        file_write(out_file_h, word(&bin_buf[0]), bin_buf_len)
        bin_buf_len = 0
    }
}

func write_tables() {
    // 1. Header (16 bytes)
    bin_write_byte('P')
    bin_write_byte('3')
    bin_write_byte('P')
    bin_write_byte(1)
    bin_write_byte(1) // FormatVer
    bin_write_byte(0) // Flags
    bin_write_word(str_pool_len)
    bin_write_word(num_globals)
    bin_write_word(num_funcs)
    bin_write_word(entry_func_idx)
    bin_write_word(total_code_size)

    // 2. Globals Table (num_globals * 2 bytes)
    for i := word(0); i < num_globals; i++ {
        bin_write_word(global_sizes[i])
    }

    // 3. String Pool (str_pool_len bytes)
    for i := word(0); i < str_pool_len; i++ {
        bin_write_byte(str_pool[i])
    }

    // 4. Function Table (num_funcs * 10 bytes)
    for i := word(0); i < num_funcs; i++ {
        bin_write_byte(func_arg_count[i])
        bin_write_byte(func_local_count[i])
        bin_write_word(func_frame_size[i])
        bin_write_word(func_code_offset[i])
        bin_write_word(func_code_size[i])
        bin_write_word(func_var_offset[i])
    }

    // 5. Local Variable Tables
    for i := word(0); i < num_funcs; i++ {
        start := func_first_var[i]
        count := word(func_arg_count[i]) + word(func_local_count[i])
        for j := word(0); j < count; j++ {
            bin_write_byte(var_sizes[start + j])
        }
    }
}

// -----------------------------------------------------------------------------
// Assembler Passes
// -----------------------------------------------------------------------------

func pass1(in_path string) {
    h, ok := file_open_read(in_path)
    if ok == 0 {
        println("Error: cannot open input file", in_path)
        sys_exit(1)
    }

    cur_func_idx = 0xFFFF
    cur_func_code_size = 0

    for {
        line, eof := file_readline(h)
        if eof != 0 {
            break
        }
        clean_line := strip_comment(line)
        if len(clean_line) == 0 {
            free(line.Base)
            continue
        }

        has_lbl := split_label(clean_line)
        if has_lbl {
            if cur_func_idx == 0xFFFF {
                println("Error: label outside function:", split_label_res)
                sys_exit(1)
            }
            lid := parse_label_id(split_label_res)
            if lid >= MAX_LABELS {
                println("Error: MAX_LABELS exceeded")
                sys_exit(1)
            }
            label_offsets[lid] = cur_func_code_size
            num_labels++

            clean_line = split_rest_res
            if len(clean_line) == 0 {
                free(line.Base)
                continue
            }
        }

        if clean_line[0] == '.' {
            split_two(clean_line)
            directive := split_first
            args := split_second

            if directive == ".global" {
                split_name_and_size(args)
                if num_globals >= MAX_GLOBALS {
                    println("Error: MAX_GLOBALS exceeded")
                    sys_exit(1)
                }
                global_names[num_globals] = clone_str(split_var_name)
                global_sizes[num_globals] = split_var_size
                map_put(global_map, split_var_name, num_globals)
                num_globals++
            } else if directive == ".function" || directive == ".func" {
                if cur_func_idx != 0xFFFF {
                    println("Error: nested function definition")
                    sys_exit(1)
                }
                split_two(args)
                fn_name := split_first
                is_entry := false
                if split_second == "entry" || fn_name == "main" {
                    is_entry = true
                }
                if num_funcs >= MAX_FUNCS {
                    println("Error: MAX_FUNCS exceeded")
                    sys_exit(1)
                }
                cur_func_idx = num_funcs
                func_names[cur_func_idx] = clone_str(fn_name)
                func_arg_count[cur_func_idx] = 0
                func_local_count[cur_func_idx] = 0
                func_frame_size[cur_func_idx] = 0
                func_first_var[cur_func_idx] = num_vars
                cur_func_code_size = 0
                reset_cur_vars()
                map_put(func_map, fn_name, cur_func_idx)
                if is_entry {
                    entry_func_idx = cur_func_idx
                }
                num_funcs++
            } else if directive == ".endfunction" || directive == ".endfunc" || directive == ".end" {
                if cur_func_idx == 0xFFFF {
                    println("Error: .endfunction outside function")
                    sys_exit(1)
                }
                func_code_size[cur_func_idx] = cur_func_code_size
                cur_func_idx = 0xFFFF
                reset_cur_vars()
            } else if directive == ".param" {
                if cur_func_idx == 0xFFFF {
                    println("Error: .param outside function")
                    sys_exit(1)
                }
                split_name_and_size(args)
                if num_vars >= MAX_VARS {
                    println("Error: MAX_VARS exceeded")
                    sys_exit(1)
                }
                if num_cur_vars >= MAX_FUNC_VARS {
                    println("Error: MAX_FUNC_VARS exceeded")
                    sys_exit(1)
                }
                slot := num_cur_vars
                fn_var_names[num_cur_vars] = clone_var_str(split_var_name)
                fn_var_slots[num_cur_vars] = byte(slot & 255)
                num_cur_vars++

                var_sizes[num_vars] = byte(split_var_size & 255)
                num_vars++
                func_arg_count[cur_func_idx]++
                func_frame_size[cur_func_idx] += split_var_size
            } else if directive == ".local" {
                if cur_func_idx == 0xFFFF {
                    println("Error: .local outside function")
                    sys_exit(1)
                }
                split_name_and_size(args)
                if num_vars >= MAX_VARS {
                    println("Error: MAX_VARS exceeded")
                    sys_exit(1)
                }
                if num_cur_vars >= MAX_FUNC_VARS {
                    println("Error: MAX_FUNC_VARS exceeded")
                    sys_exit(1)
                }
                slot := num_cur_vars
                fn_var_names[num_cur_vars] = clone_var_str(split_var_name)
                fn_var_slots[num_cur_vars] = byte(slot & 255)
                num_cur_vars++

                var_sizes[num_vars] = byte(split_var_size & 255)
                num_vars++
                func_local_count[cur_func_idx]++
                func_frame_size[cur_func_idx] += split_var_size
            } else if directive == ".entry" {
                pending_entry_name = clone_str(str_strip(args))
            }

            free(line.Base)
            continue
        }

        // Instruction
        if cur_func_idx == 0xFFFF {
            println("Error: instruction outside function:", clean_line)
            sys_exit(1)
        }
        split_two(clean_line)
        mnemonic := split_first
        operand := split_second

        opt_op := try_optimize_local(mnemonic, operand)
        if opt_op != 0xFFFF {
            cur_func_code_size += 1
        } else {
            op_idx := find_op(mnemonic)
            if op_idx == 0xFFFF {
                println("Error: unknown mnemonic", mnemonic)
                sys_exit(1)
            }
            cur_func_code_size += 1 + word(op_arg_bytes[op_idx])
            if op_arg_types[op_idx] == 5 { // str16
                if len(operand) >= 2 && ((operand[0] == '"' && operand[len(operand)-1] == '"') || (operand[0] == ''' && operand[len(operand)-1] == ''')) {
                    unescape_str(operand)
                    add_to_string_pool()
                }
            }
        }

        free(line.Base)
    }

    file_close(h)

    // Compute code offsets and total code size
    total_code_size = 0
    for i := word(0); i < num_funcs; i++ {
        func_code_offset[i] = total_code_size
        total_code_size += func_code_size[i]
    }

    // Compute var table offsets
    current_var_offset := word(0)
    for i := word(0); i < num_funcs; i++ {
        func_var_offset[i] = current_var_offset
        current_var_offset += word(func_arg_count[i]) + word(func_local_count[i])
    }

    // Finalize entry function
    finalize_entry_func()
}

func pass2(in_path string) {
    h, ok := file_open_read(in_path)
    if ok == 0 {
        println("Error: cannot reopen input file", in_path)
        sys_exit(1)
    }

    cur_func_idx = 0xFFFF
    cur_func_pc = 0

    for {
        line, eof := file_readline(h)
        if eof != 0 {
            break
        }
        clean_line := strip_comment(line)
        if len(clean_line) == 0 {
            free(line.Base)
            continue
        }

        has_lbl := split_label(clean_line)
        if has_lbl {
            clean_line = split_rest_res
            if len(clean_line) == 0 {
                free(line.Base)
                continue
            }
        }

        if clean_line[0] == '.' {
            split_two(clean_line)
            directive := split_first
            args := split_second

            if directive == ".function" || directive == ".func" {
                split_two(args)
                fn_name := split_first
                cur_func_idx = find_func(fn_name)
                cur_func_pc = 0
                reset_cur_vars()
            } else if directive == ".param" || directive == ".local" {
                split_name_and_size(args)
                if num_cur_vars >= MAX_FUNC_VARS {
                    println("Error: MAX_FUNC_VARS exceeded in Pass 2")
                    sys_exit(1)
                }
                slot := num_cur_vars
                fn_var_names[num_cur_vars] = clone_var_str(split_var_name)
                fn_var_slots[num_cur_vars] = byte(slot & 255)
                num_cur_vars++
            } else if directive == ".endfunction" || directive == ".endfunc" || directive == ".end" {
                cur_func_idx = 0xFFFF
                reset_cur_vars()
            }

            free(line.Base)
            continue
        }

        // Instruction
        split_two(clean_line)
        mnemonic := split_first
        operand := split_second

        opt_op := try_optimize_local(mnemonic, operand)
        if opt_op != 0xFFFF {
            bin_write_byte(byte(opt_op & 255))
            cur_func_pc += 1
        } else {
            op_idx := find_op(mnemonic)
            if op_idx == 0xFFFF {
                println("Error in Pass 2: unknown mnemonic", mnemonic)
                sys_exit(1)
            }
            op_byte := op_bytes[op_idx]
            arg_type := op_arg_types[op_idx]
            bin_write_byte(op_byte)

            if arg_type == 0 { // none
                cur_func_pc += 1
            } else if arg_type == 1 || arg_type == 2 || arg_type == 9 { // imm8_s, imm8_u, field8
                val := parse_int_val(operand)
                bin_write_byte(byte(val & 255))
                cur_func_pc += 2
            } else if arg_type == 7 { // local8
                slot := find_var_slot(operand)
                if slot == 0xFFFF {
                    println("Error: undefined local variable", operand, "in function", func_names[cur_func_idx])
                    sys_exit(1)
                }
                bin_write_byte(byte(slot & 255))
                cur_func_pc += 2
            } else if arg_type == 3 { // imm16
                val := parse_int_val(operand)
                bin_write_word(val)
                cur_func_pc += 3
            } else if arg_type == 4 { // rel16
                target_pc := find_label(operand)
                if target_pc == 0xFFFF {
                    println("Error: undefined label", operand, "in function", func_names[cur_func_idx])
                    sys_exit(1)
                }
                current_next_pc := cur_func_pc + 3
                rel := target_pc - current_next_pc
                bin_write_word(rel)
                cur_func_pc += 3
            } else if arg_type == 5 { // str16
                pool_off := word(0)
                if len(operand) >= 2 && ((operand[0] == '"' && operand[len(operand)-1] == '"') || (operand[0] == ''' && operand[len(operand)-1] == ''')) {
                    unescape_str(operand)
                    pool_off = add_to_string_pool()
                } else {
                    pool_off = parse_int_val(operand)
                }
                bin_write_word(pool_off)
                cur_func_pc += 3
            } else if arg_type == 6 { // func16
                fn_idx := find_func(operand)
                if fn_idx == 0xFFFF {
                    println("Error: undefined function", operand)
                    sys_exit(1)
                }
                bin_write_word(fn_idx)
                cur_func_pc += 3
            } else if arg_type == 8 { // global16
                g_idx := find_global(operand)
                if g_idx == 0xFFFF {
                    println("Error: undefined global", operand)
                    sys_exit(1)
                }
                bin_write_word(g_idx)
                cur_func_pc += 3
            }
        }

        free(line.Base)
    }

    file_close(h)
}

func default_output_name(path string) string {
    dot := word(0xFFFF)
    slash := word(0xFFFF)
    for i := word(0); i < word(len(path)); i++ {
        if path[i] == '/' || path[i] == '\\' {
            slash = i
        } else if path[i] == '.' {
            dot = i
        }
    }
    buf_clear()
    if dot != 0xFFFF && (slash == 0xFFFF || dot > slash) {
        buf_append(path[0:dot])
    } else {
        buf_append(path)
    }
    buf_append(".p3p")
    return clone_str(buf_str())
}

func assemble(in_path string, out_path string) {
    num_globals = 0
    num_funcs = 0
    num_vars = 0
    num_labels = 0
    num_strings = 0
    str_pool_len = 0
    name_pool_len = 0
    var_name_pool_len = 0
    num_cur_vars = 0
    entry_func_idx = 0xFFFF
    pending_entry_name = ""
    bin_buf_len = 0

    str_pool_map = map_new(128)
    global_map = map_new(64)
    func_map = map_new(64)

    for i := word(0); i < MAX_LABELS; i++ {
        label_offsets[i] = 0xFFFF
    }

    // PASS 1
    pass1(in_path)

    // Open output file
    h, ok := file_open_write(out_path)
    if ok == 0 {
        println("Error: cannot open output file for writing", out_path)
        sys_exit(1)
    }
    out_file_h = h

    // Write tables
    write_tables()

    // PASS 2
    pass2(in_path)

    // Flush and close
    bin_flush()
    file_close(out_file_h)

    println("Assembled", in_path, "->", out_path)
}

func get_arg(args_base word, idx word) string {
    addr := args_base + idx * 6
    var res string
    res.Base = peek(addr)
    res.Cap = peek(addr + 2)
    res.Len = peek(addr + 4)
    return res
}

func main() {
    op_map = map_new(128)
    init_opcodes()

    args := sys_args()
    if args.Len == 0 {
        println("Usage: par3asm <input.p3a> [-o <output.p3p>]")
        sys_exit(1)
    }

    in_file := ""
    out_file := ""

    i := word(0)
    for i < args.Len {
        arg := get_arg(args.Base, i)
        if arg == "-o" {
            if i + 1 < args.Len {
                out_file = get_arg(args.Base, i + 1)
                i += 2
            } else {
                i++
            }
        } else if arg == "--listing" || arg == "-v" || arg == "--verbose" {
            i++
        } else {
            if len(in_file) == 0 {
                in_file = arg
            }
            i++
        }
    }

    if len(in_file) == 0 {
        println("Error: no input file specified")
        sys_exit(1)
    }

    if len(out_file) == 0 {
        out_file = default_output_name(in_file)
    }

    assemble(in_file, out_file)
}
