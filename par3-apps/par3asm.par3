package main

// Limits for 64K VM Process Space
const MAX_GLOBALS     = 96
const MAX_FUNCS       = 80
const MAX_VARS        = 1024
const MAX_FUNC_VARS   = 64
const MAX_LABELS      = 2048
const MAX_STRING_POOL = 4096
const MAX_NAME_POOL   = 2048
const MAX_VAR_NAME_POOL = 512
const NUM_OPCODES     = 144

// Opcode Table (sorted alphabetically for binary search)
var op_names     [NUM_OPCODES]string
var op_bytes     [NUM_OPCODES]byte
var op_arg_bytes [NUM_OPCODES]byte
var op_arg_types [NUM_OPCODES]byte

// Globals Table
var global_names [MAX_GLOBALS]string
var global_sizes [MAX_GLOBALS]word
var num_globals  word

// Functions Table
var func_names       [MAX_FUNCS]string
var func_arg_count   [MAX_FUNCS]byte
var func_local_count [MAX_FUNCS]byte
var func_frame_size  [MAX_FUNCS]word
var func_code_offset [MAX_FUNCS]word
var func_code_size   [MAX_FUNCS]word
var func_var_offset  [MAX_FUNCS]word
var func_first_var   [MAX_FUNCS]word
var num_funcs        word
var entry_func_idx   word
var pending_entry_name string
var total_code_size  word

// Local Variable Table (for binary header)
var var_sizes [MAX_VARS]byte
var num_vars  word

// Current Function Variables
var fn_var_names [MAX_FUNC_VARS]string
var fn_var_slots [MAX_FUNC_VARS]byte
var num_cur_vars word

// Labels Table
var label_offsets [MAX_LABELS]word
var num_labels    word

// String Pool
var str_pool     [MAX_STRING_POOL]byte
var str_pool_len word
var num_strings  word
var str_pool_map word
var op_map       word
var global_map   word
var func_map     word

// Name Pool for Symbols
var name_pool     [MAX_NAME_POOL]byte
var name_pool_len word

// Name Pool for Current Function Variables (resets per function)
var var_name_pool     [MAX_VAR_NAME_POOL]byte
var var_name_pool_len word

// Current Assembly State
var cur_func_idx       word
var cur_func_code_size word
var cur_func_pc        word

// Binary Output Buffering
var bin_buf     [256]byte
var bin_buf_len word
var out_file_h  word

// String Buffer for Line Formatting
var out_buf [256]byte
var out_len word

// Split Results
var split_label_res string
var split_rest_res  string
var split_first     string
var split_second    string
var split_var_name  string
var split_var_size  word

// Temporary Unescape Buffer
const MAX_UNESCAPE = 256
var unescape_buf [MAX_UNESCAPE]byte
var unescape_len word

// -----------------------------------------------------------------------------
// Buffer and String Utilities
// -----------------------------------------------------------------------------

func buf_clear() {
    out_len = 0
}

func buf_append(s string) {
    for i := word(0); i < word(len(s)); i++ {
        if out_len < 255 {
            out_buf[out_len] = s[i]
            out_len++
        }
    }
}

func buf_str() string {
    var res string
    res.Base = word(&out_buf[0])
    res.Cap = 256
    res.Len = out_len
    return res
}

func clone_str(s string) string {
    if len(s) == 0 {
        return ""
    }
    slen := word(len(s))
    if name_pool_len + slen > MAX_NAME_POOL {
        println("Error: MAX_NAME_POOL exceeded")
        sys_exit(1)
    }
    p := word(&name_pool[0]) + name_pool_len
    for i := word(0); i < slen; i++ {
        name_pool[name_pool_len + i] = s[i]
    }
    name_pool_len += slen
    var res string
    res.Base = p
    res.Cap = slen
    res.Len = slen
    return res
}

func reset_cur_vars() {
    num_cur_vars = 0
    var_name_pool_len = 0
}

func clone_var_str(s string) string {
    if len(s) == 0 {
        return ""
    }
    slen := word(len(s))
    if var_name_pool_len + slen > MAX_VAR_NAME_POOL {
        println("Error: MAX_VAR_NAME_POOL exceeded")
        sys_exit(1)
    }
    p := word(&var_name_pool[0]) + var_name_pool_len
    for i := word(0); i < slen; i++ {
        var_name_pool[var_name_pool_len + i] = s[i]
    }
    var_name_pool_len += slen
    var res string
    res.Base = p
    res.Cap = slen
    res.Len = slen
    return res
}

func isspace(c byte) bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

func str_lstrip(s string) string {
    i := word(0)
    for i < word(len(s)) && isspace(s[i]) {
        i++
    }
    return s[i : len(s)]
}

func str_rstrip(s string) string {
    if len(s) == 0 {
        return ""
    }
    i := word(len(s))
    for i > 0 && isspace(s[i - 1]) {
        i--
    }
    return s[0:i]
}

func str_strip(s string) string {
    return str_rstrip(str_lstrip(s))
}

func hex_digit(c byte) word {
    if c >= '0' && c <= '9' { return word(c - '0') }
    if c >= 'a' && c <= 'f' { return word(c - 'a' + 10) }
    if c >= 'A' && c <= 'F' { return word(c - 'A' + 10) }
    return 0
}

func parse_int_val(s string) word {
    s = str_strip(s)
    if len(s) == 0 {
        return 0
    }
    is_neg := false
    idx := word(0)
    if s[0] == '-' {
        is_neg = true
        idx++
    } else if s[0] == '+' {
        idx++
    }
    base := word(10)
    if idx < word(len(s)) && s[idx] == '$' {
        base = 16
        idx++
    } else if idx + 1 < word(len(s)) && s[idx] == '0' && (s[idx+1] == 'x' || s[idx+1] == 'X') {
        base = 16
        idx += 2
    }
    res := word(0)
    for idx < word(len(s)) {
        c := s[idx]
        d := word(0)
        if c >= '0' && c <= '9' {
            d = word(c - '0')
        } else if base == 16 && c >= 'a' && c <= 'f' {
            d = word(c - 'a' + 10)
        } else if base == 16 && c >= 'A' && c <= 'F' {
            d = word(c - 'A' + 10)
        } else {
            break
        }
        res = res * base + d
        idx++
    }
    if is_neg {
        return 0 - res
    }
    return res
}

func parse_label_id(s string) word {
    s = str_strip(s)
    if len(s) == 0 {
        return 0xFFFF
    }
    i := word(len(s))
    for i > 0 && s[i-1] >= '0' && s[i-1] <= '9' {
        i--
    }
    if i == word(len(s)) {
        return 0xFFFF
    }
    return parse_int_val(s[i : len(s)])
}

func parse_size_desc(s string) word {
    s = str_strip(s)
    if len(s) == 0 {
        return 2
    }
    if s[0] == ':' {
        s = str_strip(s[1 : len(s)])
    }
    if s == "byte" || s == "uint8" || s == "bool" {
        return 1
    }
    if s == "word" || s == "scalar" || s == "int" || s == "int16" || s == "uint" || s == "uint16" || s == "buf" {
        return 2
    }
    if s == "slice" || s == "str" || s == "string" || s == "list" || s == "dict" {
        return 6
    }
    return parse_int_val(s)
}

// -----------------------------------------------------------------------------
// Parsing Line Helpers
// -----------------------------------------------------------------------------

func strip_comment(line string) string {
    if len(line) == 0 {
        return ""
    }
    if line[0] == ';' || line[0] == '#' || line[0] == '*' {
        return ""
    }
    in_quote := byte(0)
    for i := word(0); i < word(len(line)); i++ {
        c := line[i]
        if in_quote == 0 {
            if c == '"' || c == ''' {
                in_quote = c
            } else if c == ';' || c == '#' || (i == 0 && c == '*') {
                return str_strip(line[0:i])
            }
        } else {
            if c == in_quote && (i == 0 || line[i-1] != '\\') {
                in_quote = 0
            }
        }
    }
    return str_strip(line)
}

func split_label(line string) bool {
    if len(line) == 0 || isspace(line[0]) {
        split_label_res = ""
        split_rest_res = line
        return false
    }
    in_quote := byte(0)
    for i := word(0); i < word(len(line)); i++ {
        c := line[i]
        if in_quote == 0 {
            if c == '"' || c == ''' {
                in_quote = c
            } else if c == ':' {
                lbl := str_strip(line[0:i])
                has_space := false
                for j := word(0); j < word(len(lbl)); j++ {
                    if isspace(lbl[j]) {
                        has_space = true
                        break
                    }
                }
                if len(lbl) > 0 && !has_space {
                    split_label_res = lbl
                    split_rest_res = str_strip(line[i+1 : len(line)])
                    return true
                }
                break
            }
        } else {
            if c == in_quote && (i == 0 || line[i-1] != '\\') {
                in_quote = 0
            }
        }
    }
    split_label_res = ""
    split_rest_res = line
    return false
}

func split_two(s string) {
    s = str_strip(s)
    pos := word(0)
    for pos < word(len(s)) && !isspace(s[pos]) {
        pos++
    }
    split_first = s[0:pos]
    if pos < word(len(s)) {
        split_second = str_strip(s[pos : len(s)])
    } else {
        split_second = ""
    }
}

func split_name_and_size(args string) {
    args = str_strip(args)
    pos := word(0)
    for pos < word(len(args)) && !isspace(args[pos]) && args[pos] != ':' && args[pos] != ',' {
        pos++
    }
    split_var_name = args[0:pos]
    for pos < word(len(args)) && (isspace(args[pos]) || args[pos] == ':' || args[pos] == ',') {
        pos++
    }
    if pos < word(len(args)) {
        size_str := str_strip(args[pos : len(args)])
        split_var_size = parse_size_desc(size_str)
    } else {
        split_var_size = 2
    }
}

func unescape_str(lit string) {
    unescape_len = 0
    if len(lit) < 2 {
        return
    }
    body := lit[1 : len(lit)-1]
    i := word(0)
    n := word(len(body))
    for i < n {
        c := body[i]
        if c == '\\' && i + 1 < n {
            nc := body[i+1]
            if nc == 'n' {
                unescape_buf[unescape_len] = 0x0A
                unescape_len++
                i += 2
            } else if nc == 'r' {
                unescape_buf[unescape_len] = 0x0D
                unescape_len++
                i += 2
            } else if nc == 't' {
                unescape_buf[unescape_len] = 0x09
                unescape_len++
                i += 2
            } else if nc == '\\' {
                unescape_buf[unescape_len] = 0x5C
                unescape_len++
                i += 2
            } else if nc == '"' {
                unescape_buf[unescape_len] = 0x22
                unescape_len++
                i += 2
            } else if nc == ''' {
                unescape_buf[unescape_len] = 0x27
                unescape_len++
                i += 2
            } else if nc == '0' {
                unescape_buf[unescape_len] = 0x00
                unescape_len++
                i += 2
            } else if nc == 'x' && i + 3 < n {
                h := (hex_digit(body[i+2]) << 4) | hex_digit(body[i+3])
                unescape_buf[unescape_len] = byte(h & 255)
                unescape_len++
                i += 4
            } else {
                unescape_buf[unescape_len] = nc
                unescape_len++
                i += 2
            }
        } else {
            unescape_buf[unescape_len] = c
            unescape_len++
            i++
        }
    }
}

// -----------------------------------------------------------------------------
// String Pool Management
// -----------------------------------------------------------------------------

func add_to_string_pool() word {
    var unescaped_str string
    unescaped_str.Base = word(&unescape_buf[0])
    unescaped_str.Cap = unescape_len
    unescaped_str.Len = unescape_len

    off := map_get(str_pool_map, unescaped_str)
    if off != 0xFFFF {
        return off
    }

    if str_pool_len + 2 + unescape_len + 1 > MAX_STRING_POOL {
        println("Error: MAX_STRING_POOL exceeded")
        sys_exit(1)
    }
    entry_off := str_pool_len
    str_pool[str_pool_len] = byte(unescape_len >> 8)
    str_pool[str_pool_len + 1] = byte(unescape_len & 255)
    str_pool_len += 2
    for j := word(0); j < unescape_len; j++ {
        str_pool[str_pool_len + j] = unescape_buf[j]
    }
    str_pool_len += unescape_len
    str_pool[str_pool_len] = 0
    str_pool_len += 1

    num_strings++
    map_put(str_pool_map, unescaped_str, entry_off)
    return entry_off
}

// -----------------------------------------------------------------------------
// Opcode Table and Binary Search
// -----------------------------------------------------------------------------

func set_op(idx word, name string, op byte, arg_bytes byte, arg_type byte) {
    op_names[idx] = name
    op_bytes[idx] = op
    op_arg_bytes[idx] = arg_bytes
    op_arg_types[idx] = arg_type
    map_put(op_map, name, idx)
}

func find_op(m string) word {
    return map_get(op_map, m)
}

