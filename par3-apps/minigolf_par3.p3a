    .local _swap_2: slice
    .local _swap_3: slice

; if cur_tok == TOK_INT
    LOAD_GLOBAL cur_tok
    PUSH_1
    CMP_EQ
    JUMP_IF_FALSE .L_endif_525
; v := cur_int
    LOAD_GLOBAL cur_int
    STORE_LOCAL v
; next_tok()
    CALL next_tok
; if v == 0
    LOAD_LOCAL v
    PUSH_0
    CMP_EQ
