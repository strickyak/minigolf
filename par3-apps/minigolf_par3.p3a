    LOAD_LOCAL v
    PUSH_I16 65535
    CMP_EQ
    JUMP_IF_FALSE .L_else_530
; emit("    PUSH_NEG1")
    PUSH_STR "    PUSH_NEG1"
    CALL emit
    JUMP .L_endif_531
.L_else_530:
; if v <= 127
    LOAD_LOCAL v
    PUSH_I8 127
    CMP_LE
    JUMP_IF_FALSE .L_else_532
