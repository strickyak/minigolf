    STR_CMP
    NOT
    JUMP_IF_FALSE .L_else_302
; next_tok()
    CALL next_tok
; count := word(0)
    PUSH_0
    STORE_LOCAL count
; if cur_tok == TOK_INT
    LOAD_GLOBAL cur_tok
    PUSH_1
    CMP_EQ
    JUMP_IF_FALSE .L_else_304
; count = cur_int
    LOAD_GLOBAL cur_int
    STORE_LOCAL count
; next_tok()
    CALL next_tok
