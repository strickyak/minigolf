; if cur_str == "["
    LOAD_GLOBAL cur_str
    PUSH_STR "["
    STR_CMP
    NOT
    JUMP_IF_FALSE .L_else_276
; next_tok()
    CALL next_tok
; count := word(0)
    PUSH_0
    STORE_LOCAL count
; if cur_tok == TOK_INT
    LOAD_GLOBAL cur_tok
    PUSH_1
    CMP_EQ
    JUMP_IF_FALSE .L_else_278
; count = cur_int
    LOAD_GLOBAL cur_int
    STORE_LOCAL count
; next_tok()
    CALL next_tok
    JUMP .L_endif_279
.L_else_278:
; if cur_tok == TOK_IDENT
    LOAD_GLOBAL cur_tok
    PUSH_I8 3
    CMP_EQ
    JUMP_IF_FALSE .L_endif_280
; ci := find_const(cur_str)
    LOAD_GLOBAL cur_str
    CALL find_const
    STORE_LOCAL ci
; if ci != 65535
    LOAD_LOCAL ci
    PUSH_I16 65535
    CMP_NE
    JUMP_IF_FALSE .L_else_281
; count = const_vals[...]
    ADDR_OF_GLOBAL const_vals
    LOAD_LOCAL ci
    SHL1_ADD
    PEEK2
    STORE_LOCAL count
    JUMP .L_endif_282
.L_else_281:
; count = 1
    PUSH_1
    STORE_LOCAL count
.L_endif_282:
; next_tok()
    CALL next_tok
.L_endif_280:
.L_endif_279:
; expect("]")
    PUSH_STR "]"
    CALL expect
; tname := cur_str
    LOAD_GLOBAL cur_str
    STORE_LOCAL tname
; next_tok()
    CALL next_tok
; if tname == "byte" || tname == "bool" || tname == "uint8"
    LOAD_LOCAL tname
    PUSH_STR "byte"
    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_285
    POP
    LOAD_LOCAL tname
    PUSH_STR "bool"
    STR_CMP
    NOT
    JUMP .L_or_end_286
