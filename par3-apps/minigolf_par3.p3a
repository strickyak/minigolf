; if cur_str == "["
    LOAD_GLOBAL cur_str
    PUSH_STR "["
    STR_CMP
    NOT
    JUMP_IF_FALSE .L_else_288
; next_tok()
    CALL next_tok
; count := word(0)
    PUSH_0
    STORE_LOCAL count
; if cur_tok == TOK_INT
    LOAD_GLOBAL cur_tok
    PUSH_1
    CMP_EQ
    JUMP_IF_FALSE .L_else_290
; count = cur_int
    LOAD_GLOBAL cur_int
    STORE_LOCAL count
; next_tok()
    CALL next_tok
