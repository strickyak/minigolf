    PUSH_STR "string"
    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_289
    POP
    LOAD_LOCAL tname
    PUSH_STR "slice"
    STR_CMP
    NOT
    JUMP .L_or_end_290
.L_or_true_289:
.L_or_end_290:
    JUMP_IF_FALSE .L_else_291
; pt_size = count * 6
    LOAD_LOCAL count
    PUSH_I8 6
    MUL
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 6
    PUSH_I8 6
    STORE_GLOBAL pt_elem_size
    JUMP .L_endif_292
.L_else_291:
; pt_size = count * 2
    LOAD_LOCAL count
    PUSH_I8 2
    MUL
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 2
    PUSH_I8 2
    STORE_GLOBAL pt_elem_size
.L_endif_292:
.L_endif_288:
    JUMP .L_endif_277
.L_else_276:
; tname := cur_str
    LOAD_GLOBAL cur_str
    STORE_LOCAL tname
; next_tok()
    CALL next_tok
; if tname == "byte" || tname == "bool" || tname == "uint8"
    LOAD_LOCAL tname
    PUSH_STR "byte"
    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_295
    POP
    LOAD_LOCAL tname
    PUSH_STR "bool"
    STR_CMP
    NOT
    JUMP .L_or_end_296
.L_or_true_295:
.L_or_end_296:
    DUP
    JUMP_IF_TRUE .L_or_true_293
    POP
    LOAD_LOCAL tname
    PUSH_STR "uint8"
    STR_CMP
    NOT
    JUMP .L_or_end_294
.L_or_true_293:
.L_or_end_294:
    JUMP_IF_FALSE .L_else_297
; pt_size = 1
    PUSH_1
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 1
    PUSH_1
    STORE_GLOBAL pt_elem_size
    JUMP .L_endif_298
.L_else_297:
; if tname == "string" || tname == "slice"
