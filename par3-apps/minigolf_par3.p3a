; count = 1
    PUSH_1
    STORE_LOCAL count
.L_endif_294:
; next_tok()
    CALL next_tok
.L_endif_292:
.L_endif_291:
; expect("]")
    PUSH_STR "]"
    CALL expect
; tname := cur_str
    LOAD_GLOBAL cur_str
