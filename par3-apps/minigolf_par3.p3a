; next_tok()
    CALL next_tok
; if tname == "byte" || tname == "bool" || tname == "uint8"
    LOAD_LOCAL tname
    PUSH_STR "byte"
    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_297
    POP
    LOAD_LOCAL tname
    PUSH_STR "bool"
