    NOT
    JUMP .L_or_end_284
.L_or_true_283:
.L_or_end_284:
    JUMP_IF_FALSE .L_else_287
; pt_size = count
    LOAD_LOCAL count
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 1
    PUSH_1
    STORE_GLOBAL pt_elem_size
    JUMP .L_endif_288
.L_else_287:
; if tname == "string" || tname == "slice"
