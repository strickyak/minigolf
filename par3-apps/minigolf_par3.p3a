    .local _swap_2: slice
    .local _swap_3: slice

; if cur_tok == TOK_INT
    LOAD_GLOBAL cur_tok
    PUSH_1
    CMP_EQ
    JUMP_IF_FALSE .L_endif_520
; v := cur_int
    LOAD_GLOBAL cur_int
    STORE_LOCAL v
; next_tok()
    CALL next_tok
; if v == 0
    LOAD_LOCAL v
    PUSH_0
    CMP_EQ
    JUMP_IF_FALSE .L_else_521
; emit("    PUSH_0")
    PUSH_STR "    PUSH_0"
    CALL emit
    JUMP .L_endif_522
