; if ci != 65535
    LOAD_LOCAL ci
    PUSH_I16 65535
    CMP_NE
    JUMP_IF_FALSE .L_else_293
; count = const_vals[...]
    ADDR_OF_GLOBAL const_vals
    LOAD_LOCAL ci
    SHL1_ADD
    PEEK2
    STORE_LOCAL count
    JUMP .L_endif_294
