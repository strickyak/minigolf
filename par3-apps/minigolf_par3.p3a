    LOAD_LOCAL v
    PUSH_I16 65535
    CMP_EQ
    JUMP_IF_FALSE .L_else_525
; emit("    PUSH_NEG1")
    PUSH_STR "    PUSH_NEG1"
    CALL emit
    JUMP .L_endif_526
.L_else_525:
; if v <= 127
    LOAD_LOCAL v
    PUSH_I8 127
    CMP_LE
    JUMP_IF_FALSE .L_else_527
; emit_u8("    PUSH_I8 ", v)
    PUSH_STR "    PUSH_I8 "
    LOAD_LOCAL v
    CALL emit_u8
    JUMP .L_endif_528
.L_else_527:
; emit_u16("    PUSH_I16 ", v)
    PUSH_STR "    PUSH_I16 "
