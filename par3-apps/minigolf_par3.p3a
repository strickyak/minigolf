    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_299
    POP
    LOAD_LOCAL tname
    PUSH_STR "slice"
    STR_CMP
    NOT
    JUMP .L_or_end_300
.L_or_true_299:
.L_or_end_300:
    JUMP_IF_FALSE .L_else_301
; pt_size = 6
    PUSH_I8 6
    STORE_GLOBAL pt_size
; pt_kind = KIND_SLICE
    PUSH_I8 2
    STORE_GLOBAL pt_kind
; pt_elem_size = 1
    PUSH_1
    STORE_GLOBAL pt_elem_size
    JUMP .L_endif_302
.L_else_301:
; pt_size = 2
    PUSH_I8 2
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 2
    PUSH_I8 2
    STORE_GLOBAL pt_elem_size
.L_endif_302:
.L_endif_298:
.L_endif_277:
    RET_VOID
.endfunction

