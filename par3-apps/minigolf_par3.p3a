    STORE_GLOBAL pt_elem_size
    JUMP .L_endif_304
.L_else_303:
; pt_size = count * 2
    LOAD_LOCAL count
    PUSH_I8 2
    MUL
    STORE_GLOBAL pt_size
; pt_kind = KIND_SCALAR
    PUSH_1
    STORE_GLOBAL pt_kind
; pt_elem_size = 2
    PUSH_I8 2
    STORE_GLOBAL pt_elem_size
.L_endif_304:
.L_endif_300:
    JUMP .L_endif_289
.L_else_288:
; tname := cur_str
    LOAD_GLOBAL cur_str
    STORE_LOCAL tname
; next_tok()
    CALL next_tok
; if tname == "byte" || tname == "bool" || tname == "uint8"
    LOAD_LOCAL tname
    PUSH_STR "byte"
    STR_CMP
    NOT
    DUP
    JUMP_IF_TRUE .L_or_true_307
    POP
