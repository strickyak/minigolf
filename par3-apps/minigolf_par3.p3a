    STR_CMP
    NOT
    JUMP .L_or_end_302
.L_or_true_301:
.L_or_end_302:
    JUMP_IF_FALSE .L_else_303
; pt_size = count * 6
    LOAD_LOCAL count
    PUSH_I8 6
    MUL
