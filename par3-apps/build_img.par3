package main

const MAX_MODS = 64

const SLOT_4   = 4  // $8000..$A000
const SLOT_5   = 5  // $A000..$C000
const SLOT_6   = 6  // $C000..$E000
const SLOT_7L  = 7  // $E000..$EE00
const SLOT_KRN = 8  // $EE00..$FF00

// 256-byte sector I/O buffers
var io_buf     [256]byte
var zero_buf   [256]byte
var dec_digits [8]byte
var name_raw   [32]byte

// Module table (up to 64 modules)
var mod_role     [64]string
var mod_path     [64]string
var mod_slot     [64]word
var mod_size     [64]word
var mod_name     [64]string
var mod_exec_off [64]word
var num_mods     word
var mod_dir      string

var slot4_first_addr word

func add_mod(slot word, role string, path string) {
    if num_mods >= MAX_MODS {
        println("ERROR: Exceeded MAX_MODS (64)")
        sys_exit(1)
    }
    mod_slot[num_mods] = slot
    mod_role[num_mods] = role
    mod_path[num_mods] = path
    mod_size[num_mods] = 0
    mod_name[num_mods] = ""
    mod_exec_off[num_mods] = 0
    num_mods++
}

func print_hex4(v word) {
    hex := "0123456789ABCDEF"
    idx := v & 0xF
    print(hex[idx : idx + 1])
}

func print_hex16(v word) {
    print("$")
    print_hex4(v >> 12)
    print_hex4(v >> 8)
    print_hex4(v >> 4)
    print_hex4(v)
}

func print_pad(s string, width word) {
    print(s)
    slen := word(len(s))
    for slen < width {
        print(" ")
        slen++
    }
}

func print_dec_pad(val word, width word) {
    pos := word(0)
    if val == 0 {
        dec_digits[0] = 0
        pos = 1
    } else {
        temp := val
        for temp > 0 {
            dec_digits[pos] = byte(temp % 10)
            pos++
            temp = temp / 10
        }
        for i := word(0); i < pos/2; i++ {
            j := pos - 1 - i
            b := dec_digits[i]
            dec_digits[i] = dec_digits[j]
            dec_digits[j] = b
        }
    }
    digits := "0123456789"
    for i := word(0); i < pos; i++ {
        d := word(dec_digits[i])
        print(digits[d : d+1])
    }
    for pos < width {
        print(" ")
        pos++
    }
}

func read_be16(buf word, off word) word {
    hi := word(peekb(buf + off))
    lo := word(peekb(buf + off + 1))
    return (hi << 8) | lo
}

func write_be16(buf word, off word, val word) {
    pokeb(buf + off, byte((val >> 8) & 0xFF))
    pokeb(buf + off + 1, byte(val & 0xFF))
}

func basename(path string) string {
    i := word(len(path))
    for i > 0 {
        i--
        if path[i] == '/' {
            return path[i+1 : word(len(path))]
        }
    }
    return path
}

// extract_os9_name reads the high-bit terminated ASCII name and creates a permanent string
func extract_os9_name(name_off word, n_read word) string {
    out_len := word(0)
    p := name_off
    for out_len < 31 && p < n_read {
        b := peekb(word(&io_buf[0]) + p)
        p++
        pokeb(word(&name_raw[0]) + out_len, b & 0x7F)
        out_len++
        if (b & 0x80) != 0 {
            break
        }
    }
    var s string
    s.Base = alloc(out_len + 1)
    s.Cap = out_len
    s.Len = out_len
    for i := word(0); i < out_len; i++ {
        pokeb(s.Base + i, peekb(word(&name_raw[0]) + i))
    }
    pokeb(s.Base + out_len, 0)
    return s
}

// inspect_module reads the first 64 bytes to extract size, name, and exec_off
func inspect_module(idx word) {
    m_path := mod_path[idx]
    h, ok := file_open_read(m_path)
    if ok == 0 {
        print("ERROR: Cannot open module: ")
        println(m_path)
        sys_exit(1)
    }

    n := file_read(h, word(&io_buf[0]), 64)
    file_close(h)

    if n < 16 || peekb(word(&io_buf[0])) != 0x87 || peekb(word(&io_buf[0]) + 1) != 0xCD {
        print("ERROR: Invalid sync bytes in: ")
        println(m_path)
        sys_exit(1)
    }

    sz := read_be16(word(&io_buf[0]), 2)
    if mod_slot[idx] == SLOT_KRN {
        sz = 0x1100
    }
    mod_size[idx] = sz
    name_off := read_be16(word(&io_buf[0]), 4)
    mod_exec_off[idx] = read_be16(word(&io_buf[0]), 9)

    mod_name[idx] = extract_os9_name(name_off, n)
}

// write_zeroes streams zero bytes in blocks of up to 256 bytes
func write_zeroes(out_h word, count word) {
    for count > 0 {
        chunk := count
        if chunk > 256 {
            chunk = 256
        }
        file_write(out_h, word(&zero_buf[0]), chunk)
        count -= chunk
    }
}

// stream_file copies a module file to out_h in 256-byte sector chunks
func stream_file(out_h word, path string, expected_size word) {
    in_h, ok := file_open_read(path)
    if ok == 0 {
        print("ERROR: Cannot open for streaming: ")
        println(path)
        sys_exit(1)
    }

    rem := expected_size
    for rem > 0 {
        chunk := rem
        if chunk > 256 {
            chunk = 256
        }
        n := file_read(in_h, word(&io_buf[0]), chunk)
        if n == 0 {
            break
        }
        file_write(out_h, word(&io_buf[0]), n)
        rem -= n
    }
    file_close(in_h)
}

// stream_slot calculates leading zero padding and streams all modules in slot_id
func stream_slot(out_h word, slot_id word, slot_start word, slot_end word) {
    total_size := word(0)
    count := word(0)

    for i := word(0); i < num_mods; i++ {
        if mod_slot[i] == slot_id {
            total_size += mod_size[i]
            count++
        }
    }

    slot_capacity := slot_end - slot_start
    if count == 0 {
        write_zeroes(out_h, slot_capacity)
        return
    }

    if total_size > slot_capacity {
        print("ERROR: Overflow in slot starting at ")
        print_hex16(slot_start)
        println("!")
        sys_exit(1)
    }

    lead_zeros := slot_capacity - total_size
    curr_addr := slot_start + lead_zeros

    if slot_id == SLOT_4 {
        slot4_first_addr = curr_addr
    }

    // 1. Stream leading zero padding
    write_zeroes(out_h, lead_zeros)

    // 2. Stream modules in insertion order
    for i := word(0); i < num_mods; i++ {
        if mod_slot[i] == slot_id {
            print_pad(mod_role[i], 18)
            print(" ")
            print_pad(basename(mod_path[i]), 25)
            print(" ")
            print_hex16(curr_addr)
            print("   ")
            print_hex16(mod_size[i])
            print(" (")
            print_dec_pad(mod_size[i], 5)
            print(") ")
            print_pad(mod_name[i], 10)
            print(" ")
            print_hex16(mod_exec_off[i])
            println("")

            stream_file(out_h, mod_path[i], mod_size[i])
            curr_addr += mod_size[i]
        }
    }
}

func path_join(dir string, file string) string {
    need_slash := false
    if len(dir) > 0 && dir[len(dir)-1] != '/' {
        need_slash = true
    }
    total := word(len(dir)) + word(len(file))
    if need_slash {
        total++
    }
    p := alloc(total)
    off := word(0)
    for i := word(0); i < word(len(dir)); i++ {
        pokeb(p + off, dir[i])
        off++
    }
    if need_slash {
        pokeb(p + off, '/')
        off++
    }
    for i := word(0); i < word(len(file)); i++ {
        pokeb(p + off, file[i])
        off++
    }
    var res string
    res.Base = p
    res.Cap = total
    res.Len = total
    return res
}

func register_deep_modules(dir string) {
    // Slot 4 ($8000..$9FFF): Remaining commands
    add_mod(SLOT_4, "dir Command",     path_join(dir, "dir"))
    add_mod(SLOT_4, "setime Command",  path_join(dir, "setime"))
    add_mod(SLOT_4, "date Command",    path_join(dir, "date"))
    add_mod(SLOT_4, "stop Command",    path_join(dir, "stop"))

    // Slot 5 ($A000..$BFFF): SCF, drivers, shell & commands
    add_mod(SLOT_5, "SCF Manager",     path_join(dir, "scf"))
    add_mod(SLOT_5, "ACIA Driver",     path_join(dir, "sc6850"))
    add_mod(SLOT_5, "Clock Driver",    path_join(dir, "clock"))
    add_mod(SLOT_5, "Term Descriptor", path_join(dir, "term"))
    add_mod(SLOT_5, "Shell Command",   path_join(dir, "shell_21"))
    add_mod(SLOT_5, "mfree Command",   path_join(dir, "mfree"))
    add_mod(SLOT_5, "free Command",    path_join(dir, "free"))
    add_mod(SLOT_5, "procs Command",   path_join(dir, "procs"))
    add_mod(SLOT_5, "mdir Command",    path_join(dir, "mdir"))

    // Slot 6 ($C000..$DFFF): Storage subsystem
    add_mod(SLOT_6, "DD Descriptor",   path_join(dir, "dd"))
    add_mod(SLOT_6, "EmuDsk Driver",   path_join(dir, "emudsk"))
    add_mod(SLOT_6, "SysGo Module",    path_join(dir, "sysgo"))
    add_mod(SLOT_6, "RBF Manager",     path_join(dir, "rbf"))
    add_mod(SLOT_6, "I/O Manager",     path_join(dir, "ioman"))

    // Slot 7 Lower ($E000..$EE00): Configuration & Kernel Part 2
    add_mod(SLOT_7L, "Configuration",   path_join(dir, "init"))
    add_mod(SLOT_7L, "Kernel (part 2)", path_join(dir, "krnp2"))

    // Slot 7 Kernel ($EE00..$FF00): Kernel Part 1
    add_mod(SLOT_KRN, "Kernel (part 1)", path_join(dir, "krn"))
}

func register_flat_modules(dir string) {
    add_mod(1, "Kernel (part 1)", path_join(dir, "krn"))
    add_mod(1, "Kernel (part 2)", path_join(dir, "krnp2"))
    add_mod(1, "Configuration",   path_join(dir, "init"))
    add_mod(1, "I/O Manager",     path_join(dir, "ioman"))
    add_mod(1, "RBF Manager",     path_join(dir, "rbf"))
    add_mod(1, "SCF Manager",     path_join(dir, "scf"))
    add_mod(1, "ACIA Driver",     path_join(dir, "sc6850"))
    add_mod(1, "Clock Driver",    path_join(dir, "clock"))
    add_mod(1, "Term Descriptor", path_join(dir, "term"))
    add_mod(1, "EmuDsk Driver",   path_join(dir, "emudsk"))
    add_mod(1, "DD Descriptor",   path_join(dir, "dd"))
    add_mod(1, "SysGo Module",    path_join(dir, "sysgo"))
    add_mod(1, "Shell Command",   path_join(dir, "shell_21"))
    add_mod(1, "mfree Command",   path_join(dir, "mfree"))
    add_mod(1, "free Command",    path_join(dir, "free"))
    add_mod(1, "procs Command",   path_join(dir, "procs"))
    add_mod(1, "mdir Command",    path_join(dir, "mdir"))
    add_mod(1, "dir Command",     path_join(dir, "dir"))
    add_mod(1, "setime Command",  path_join(dir, "setime"))
    add_mod(1, "date Command",    path_join(dir, "date"))
    add_mod(1, "stop Command",    path_join(dir, "stop"))
}

func has_substr(s string, sub string) bool {
    if len(s) < len(sub) {
        return false
    }
    limit := word(len(s)) - word(len(sub))
    for i := word(0); i <= limit; i++ {
        match := true
        for j := word(0); j < word(len(sub)); j++ {
            if s[i+j] != sub[j] {
                match = false
                break
            }
        }
        if match {
            return true
        }
    }
    return false
}

func get_arg(args_base word, idx word) string {
    addr := args_base + idx * 6
    var res string
    res.Base = peek(addr)
    res.Cap = peek(addr + 2)
    res.Len = peek(addr + 4)
    return res
}

func main() {
    is_flat := false
    mod_dir := ""
    out_path := ""
    args := sys_args()
    for i := word(0); i < args.Len; i++ {
        arg := get_arg(args.Base, i)
        if arg == "--flat" {
            is_flat = true
        } else if arg == "--deep" {
            is_flat = false
        } else if len(mod_dir) == 0 {
            mod_dir = arg
        } else if len(out_path) == 0 {
            out_path = arg
        }
    }

    if !is_flat {
        if has_substr(out_path, "flat") || has_substr(mod_dir, "flat") {
            is_flat = true
        }
    }

    if len(out_path) == 0 {
        if is_flat {
            out_path = "flat65280.img"
        } else {
            out_path = "deep65280.img"
        }
    }
    if len(mod_dir) == 0 {
        if is_flat {
            mod_dir = ".mods"
        } else {
            mod_dir = "/dd/MODS"
        }
    }

    num_mods = 0
    if is_flat {
        register_flat_modules(mod_dir)
    } else {
        register_deep_modules(mod_dir)
    }

    // Pass 1: Inspect all module headers
    for i := word(0); i < num_mods; i++ {
        inspect_module(i)
    }

    out_h, ok := file_open_write(out_path)
    if ok == 0 {
        print("ERROR: Cannot create output image: ")
        println(out_path)
        sys_exit(1)
    }

    print_pad("Role", 18)
    print(" ")
    print_pad("File", 25)
    print(" ")
    print_pad("Addr", 8)
    print(" ")
    print_pad("Size", 8)
    print(" ")
    print_pad("Name", 10)
    print(" ")
    print_pad("Exec", 8)
    println("")

    for i := word(0); i < 80; i++ {
        print("-")
    }
    println("")

    if is_flat {
        // Flat sequential packing starting at $0800
        write_zeroes(out_h, 0x0800)
        curr_addr := 0x0800
        krn_exec := 0x0800 + mod_exec_off[0]

        for i := word(0); i < num_mods; i++ {
            print_pad(mod_role[i], 18)
            print(" ")
            print_pad(basename(mod_path[i]), 25)
            print(" ")
            print_hex16(curr_addr)
            print("   ")
            print_hex16(mod_size[i])
            print(" (")
            print_dec_pad(mod_size[i], 5)
            print(") ")
            print_pad(mod_name[i], 10)
            print(" ")
            print_hex16(mod_exec_off[i])
            println("")

            stream_file(out_h, mod_path[i], mod_size[i])
            curr_addr += mod_size[i]
        }

        for i := word(0); i < 80; i++ {
            print("-")
        }
        println("")

        print("Total module space used: $0800..")
        print_hex16(curr_addr)
        print(" (")
        print_dec_pad(curr_addr - 0x0800, 5)
        println(" bytes)")

        print("Free RAM before I/O: ")
        print_hex16(curr_addr)
        println("..$FEFF")

        // Free RAM up to $FFF0
        write_zeroes(out_h, 0xFFF0 - curr_addr)

        // CPU Vectors ($FFF0..$FFFF)
        write_be16(word(&io_buf[0]), 0,  0x0100) // TRAP
        write_be16(word(&io_buf[0]), 2,  0x0100) // SWI3
        write_be16(word(&io_buf[0]), 4,  0x0103) // SWI2
        write_be16(word(&io_buf[0]), 6,  0x010F) // FIRQ
        write_be16(word(&io_buf[0]), 8,  0x010C) // IRQ
        write_be16(word(&io_buf[0]), 10, 0x0106) // SWI
        write_be16(word(&io_buf[0]), 12, 0x0109) // NMI
        write_be16(word(&io_buf[0]), 14, krn_exec) // RESET

        file_write(out_h, word(&io_buf[0]), 16)
        file_close(out_h)

        print("Reset vector ($FFFE) set to: ")
        print_hex16(krn_exec)
        println("")

        print("Successfully generated ")
        print(out_path)
        println(" (65536 bytes)")
        sys_exit(0)
    }

    // Deep slot packing: Pass 2: Stream complete 64KB image sequentially
    // 1. Slots 0..3 ($0000..$8000): 32KB RAM zeroes
    write_zeroes(out_h, 0x8000)

    // 2. Slot 4 ($8000..$A000)
    stream_slot(out_h, SLOT_4, 0x8000, 0xA000)

    // 3. Slot 5 ($A000..$C000)
    stream_slot(out_h, SLOT_5, 0xA000, 0xC000)

    // 4. Slot 6 ($C000..$E000)
    stream_slot(out_h, SLOT_6, 0xC000, 0xE000)

    // 5. Slot 7 Lower ($E000..$EE00)
    stream_slot(out_h, SLOT_7L, 0xE000, 0xEE00)

    // 6. Slot 7 Kernel ($EE00..$FF00)
    krn_idx := word(0xFFFF)
    for i := word(0); i < num_mods; i++ {
        if mod_slot[i] == SLOT_KRN {
            krn_idx = i
            break
        }
    }
    if krn_idx == 0xFFFF || mod_size[krn_idx] != 0x1100 {
        println("ERROR: Kernel missing or size != $1100")
        sys_exit(1)
    }

    print_pad(mod_role[krn_idx], 18)
    print(" ")
    print_pad("krn", 25)
    print(" ")
    print_hex16(0xEE00)
    print("   ")
    print_hex16(mod_size[krn_idx])
    print(" (")
    print_dec_pad(mod_size[krn_idx], 5)
    print(") ")
    print_pad("Krn", 10)
    print(" ")
    print_hex16(mod_exec_off[krn_idx])
    println("")

    stream_file(out_h, mod_path[krn_idx], mod_size[krn_idx])
    krn_exec := 0xEE00 + mod_exec_off[krn_idx]

    for i := word(0); i < 80; i++ {
        print("-")
    }
    println("")

    println("Slot 0 ($0000..$1FFF): System globals, DP, stack (zeroed)")
    println("Slots 1..3 ($2000..$7FFF) + lower Slot 4: Free dynamic RAM (31KB)")

    print("Slots 4..7 (")
    print_hex16(slot4_first_addr)
    println("..$EDFF): Preloaded modules (high-packed, abutting $EE00)")

    println("Slot 7 ($EE00..$FFFF): Kernel at $EE00, size $1100, ends at $FF00")

    print("Reset vector ($FFFE) set to: ")
    print_hex16(krn_exec)
    println("")
    println("SWI2 vector ($FFF4) set to:  $FEF1")
    println("IRQ vector ($FFF8) set to:   $FEF7")

    // 7. I/O Page ($FF00..$FFEF): 240 zeroes
    write_zeroes(out_h, 0xF0)

    // 8. CPU Vectors ($FFF0..$FFFF): 16 bytes
    write_be16(word(&io_buf[0]), 0,  0xFEEE) // TRAP
    write_be16(word(&io_buf[0]), 2,  0xFEEE) // SWI3
    write_be16(word(&io_buf[0]), 4,  0xFEF1) // SWI2
    write_be16(word(&io_buf[0]), 6,  0xFEF4) // FIRQ
    write_be16(word(&io_buf[0]), 8,  0xFEF7) // IRQ
    write_be16(word(&io_buf[0]), 10, 0xFEFA) // SWI
    write_be16(word(&io_buf[0]), 12, 0xFEFD) // NMI
    write_be16(word(&io_buf[0]), 14, krn_exec) // RESET

    file_write(out_h, word(&io_buf[0]), 16)
    file_close(out_h)

    print("Successfully generated ")
    print(out_path)
    println(" (65536 bytes)")
    sys_exit(0)
}
