    STORE_LOCAL _tmp_base
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    LOAD_LOCAL _tmp_base
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 6
    ADD
    LOAD_LOCAL _tmp_cap
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 8
    ADD
    LOAD_LOCAL _tmp_len
    POKE2
    LOAD_LOCAL _pbuf
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 2
    ADD
    PUSH_STR "string"
    POP
    POP
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_1
    PUSH_1
    PRINT
    LOAD_LOCAL _pbuf
    BUF_FREE
    RET_VOID
.endfunction

