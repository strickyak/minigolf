; ====================================================================
; Function: print_dec_pad
; ====================================================================
.function print_dec_pad
    .param val: word
    .param width: word
    .local pos: word
    .local temp: word
    .local i: word
    .local j: word
    .local b: byte
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; pos := word(0)
    PUSH_0
    STORE_LOCAL pos
; if val == 0
    LOAD_LOCAL val
    PUSH_0
    CMP_EQ
    JUMP_IF_FALSE .L_else_6
; dec_digits[...] = 48
    PUSH_I8 48
    ADDR_OF_GLOBAL dec_digits
    PUSH_0
    ADD
    SWAP
    POKE1
; pos = 1
    PUSH_1
    STORE_LOCAL pos
    JUMP .L_endif_7
.L_else_6:
; temp := val
    LOAD_LOCAL val
    STORE_LOCAL temp
; for temp > 0
.L_for_top_8:
    LOAD_LOCAL temp
    PUSH_0
    CMP_GT
    JUMP_IF_FALSE .L_for_exit_9
; dec_digits[...] = byte(48 + temp %!)(MISSING)
    PUSH_I8 48
    LOAD_LOCAL temp
    PUSH_I8 10
    MOD
    ADD
    PUSH_I16 255
    BIT_AND
    ADDR_OF_GLOBAL dec_digits
    LOAD_LOCAL pos
    ADD
    SWAP
    POKE1
; pos++
    LOAD_LOCAL pos
    PUSH_1
    ADD
    STORE_LOCAL pos
; temp /= 10
    LOAD_LOCAL temp
    PUSH_I8 10
    DIV
    STORE_LOCAL temp
    JUMP .L_for_top_8
.L_for_exit_9:
; for <init>; <cond>; <inc>
; i := word(0)
    PUSH_0
    STORE_LOCAL i
.L_for3_top_10:
    LOAD_LOCAL i
    LOAD_LOCAL pos
    PUSH_I8 2
    DIV
    CMP_LT
    JUMP_IF_FALSE .L_for3_exit_12
; j := pos - 1 - i
    LOAD_LOCAL pos
    PUSH_1
    SUB
    LOAD_LOCAL i
    SUB
    STORE_LOCAL j
; b := dec_digits[...]
    ADDR_OF_GLOBAL dec_digits
    LOAD_LOCAL i
    ADD
    PEEK1
    STORE_LOCAL b
; dec_digits[...] = dec_digits[...]
    ADDR_OF_GLOBAL dec_digits
    LOAD_LOCAL j
    ADD
    PEEK1
    ADDR_OF_GLOBAL dec_digits
    LOAD_LOCAL i
    ADD
    SWAP
    POKE1
; dec_digits[...] = b
    LOAD_LOCAL b
    ADDR_OF_GLOBAL dec_digits
    LOAD_LOCAL j
    ADD
    SWAP
    POKE1
.L_for3_cont_11:
; i++
    LOAD_LOCAL i
    PUSH_1
    ADD
    STORE_LOCAL i
    JUMP .L_for3_top_10
.L_for3_exit_12:
.L_endif_7:
; for <init>; <cond>; <inc>
; i := word(0)
    PUSH_0
    STORE_LOCAL i
.L_for3_top_13:
    LOAD_LOCAL i
    LOAD_LOCAL pos
    CMP_LT
    JUMP_IF_FALSE .L_for3_exit_15
; print(dec_digits[...])
; print(dec_digits[...])
    PUSH_I16 10
    BUF_ALLOC
    STORE_LOCAL _pbuf
    ADDR_OF_GLOBAL dec_digits
    PUSH_I16 8
    PUSH_I16 8
    SLICE_NEW
    LOAD_LOCAL i
    LOAD_LOCAL i
    PUSH_1
    ADD
    SLICE_SUB
    STORE_LOCAL _tmp_len
    STORE_LOCAL _tmp_cap
    STORE_LOCAL _tmp_base
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    LOAD_LOCAL _tmp_base
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 6
    ADD
    LOAD_LOCAL _tmp_cap
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 8
    ADD
    LOAD_LOCAL _tmp_len
    POKE2
    LOAD_LOCAL _pbuf
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 2
    ADD
    PUSH_STR "string"
    POP
    POP
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_1
    PUSH_1
    PRINT
    LOAD_LOCAL _pbuf
    BUF_FREE
.L_for3_cont_14:
; i++
    LOAD_LOCAL i
    PUSH_1
    ADD
    STORE_LOCAL i
    JUMP .L_for3_top_13
.L_for3_exit_15:
; for pos < width
.L_for_top_16:
    LOAD_LOCAL pos
    LOAD_LOCAL width
    CMP_LT
    JUMP_IF_FALSE .L_for_exit_17
; print(" ")
; print(" ")
