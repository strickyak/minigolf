; ====================================================================
; Function: add_mod
; ====================================================================
.function add_mod
    .param slot: word
    .param role: slice
    .param path: slice
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; if num_mods >= MAX_MODS
    LOAD_GLOBAL num_mods
    PUSH_I8 64
    CMP_GE
    JUMP_IF_FALSE .L_endif_3
; println("ERROR: Exceeded MAX_MODS (64)")
; println("ERROR: Exceeded MAX_MODS (64)")
    PUSH_I16 10
    BUF_ALLOC
    STORE_LOCAL _pbuf
    PUSH_STR "ERROR: Exceeded MAX_MODS (64)"
    STORE_LOCAL _tmp_len
    STORE_LOCAL _tmp_cap
    STORE_LOCAL _tmp_base
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    LOAD_LOCAL _tmp_base
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 6
    ADD
    LOAD_LOCAL _tmp_cap
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 8
    ADD
    LOAD_LOCAL _tmp_len
    POKE2
    LOAD_LOCAL _pbuf
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 2
    ADD
    PUSH_STR "string"
    POP
    POP
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_1
    PUSH_1
    PRINTLN
    LOAD_LOCAL _pbuf
    BUF_FREE
; sys_exit(1)
    PUSH_1
    SYS_EXIT
.L_endif_3:
; mod_slot[...] = slot
    LOAD_LOCAL slot
    ADDR_OF_GLOBAL mod_slot
    LOAD_GLOBAL num_mods
    SHL1_ADD
    SWAP
    POKE2
; mod_role[...] = role
    LOAD_LOCAL role
    ADDR_OF_GLOBAL mod_role
    LOAD_GLOBAL num_mods
    PUSH_I16 6
    MUL
    ADD
    STORE_LOCAL _tmp_addr
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    SWAP
    POKE2
; mod_path[...] = path
    LOAD_LOCAL path
    ADDR_OF_GLOBAL mod_path
    LOAD_GLOBAL num_mods
    PUSH_I16 6
    MUL
    ADD
    STORE_LOCAL _tmp_addr
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    SWAP
    POKE2
; mod_size[...] = 0
    PUSH_0
    ADDR_OF_GLOBAL mod_size
    LOAD_GLOBAL num_mods
    SHL1_ADD
    SWAP
    POKE2
; mod_name[...] = ""
    PUSH_STR ""
    ADDR_OF_GLOBAL mod_name
    LOAD_GLOBAL num_mods
    PUSH_I16 6
    MUL
    ADD
    STORE_LOCAL _tmp_addr
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    SWAP
    POKE2
; mod_exec_off[...] = 0
    PUSH_0
    ADDR_OF_GLOBAL mod_exec_off
    LOAD_GLOBAL num_mods
    SHL1_ADD
    SWAP
    POKE2
; num_mods++
    LOAD_GLOBAL num_mods
    PUSH_1
    ADD
    STORE_GLOBAL num_mods
    RET_VOID
.endfunction

; ====================================================================
