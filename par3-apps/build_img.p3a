; hex := "0123456789ABCDEF"
    PUSH_STR "0123456789ABCDEF"
    STORE_LOCAL hex
; idx := v & 15
    LOAD_LOCAL v
    PUSH_I8 15
    BIT_AND
    STORE_LOCAL idx
; print(hex[...])
; print(hex[...])
