; ====================================================================
; Function: read_be16
; ====================================================================
.function read_be16
    .param buf: word
    .param off: word
    .local hi: word
    .local lo: word
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; hi := word(peekb(buf + off))
    LOAD_LOCAL buf
    LOAD_LOCAL off
    ADD
    PEEK1
    STORE_LOCAL hi
; lo := word(peekb(buf + off + 1))
    LOAD_LOCAL buf
    LOAD_LOCAL off
    ADD
    PUSH_1
    ADD
    PEEK1
    STORE_LOCAL lo
; return hi << 8 | lo
    LOAD_LOCAL hi
    PUSH_I8 8
    SHL
    LOAD_LOCAL lo
    BIT_OR
    RET
    RET_VOID
.endfunction

; ====================================================================
; Function: write_be16
; ====================================================================
.function write_be16
    .param buf: word
    .param off: word
    .param val: word
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; pokeb(buf + off, byte(val >> 8 & 255))
    LOAD_LOCAL buf
    LOAD_LOCAL off
    ADD
    LOAD_LOCAL val
    PUSH_I8 8
    SHR
    PUSH_I16 255
    BIT_AND
    PUSH_I16 255
    BIT_AND
    POKE1
; pokeb(buf + off + 1, byte(val & 255))
    LOAD_LOCAL buf
    LOAD_LOCAL off
    ADD
    PUSH_1
    ADD
    LOAD_LOCAL val
    PUSH_I16 255
    BIT_AND
    PUSH_I16 255
    BIT_AND
    POKE1
    RET_VOID
.endfunction

; ====================================================================
; Function: basename
; ====================================================================
.function basename
    .param path: slice
    .local i: word
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; i := word(len(path))
    LOAD_LOCAL path
    SLICE_LEN
    STORE_LOCAL i
; for i > 0
.L_for_top_18:
    LOAD_LOCAL i
    PUSH_0
    CMP_GT
    JUMP_IF_FALSE .L_for_exit_19
; i--
    LOAD_LOCAL i
    PUSH_1
    SUB
    STORE_LOCAL i
; if path[...] == 47
    ADDR_OF_LOCAL path
    PEEK2
    LOAD_LOCAL i
    ADD
    PEEK1
    PUSH_I8 47
    CMP_EQ
    JUMP_IF_FALSE .L_endif_20
; return path[...]
    LOAD_LOCAL path
    LOAD_LOCAL i
    PUSH_1
    ADD
    LOAD_LOCAL path
    SLICE_LEN
    SLICE_SUB
    RET_SLICE
.L_endif_20:
    JUMP .L_for_top_18
.L_for_exit_19:
; return path
    LOAD_LOCAL path
    RET_SLICE
    RET_VOID
.endfunction

; ====================================================================
; Function: extract_os9_name
; ====================================================================
