    ADDR_OF_GLOBAL mod_path    LOAD_GLOBAL num_mods    PUSH_I8 6    MUL    ADD    STORE_LOCAL _tmp_dest_addr    LOAD_LOCAL path    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _tmp_dest_addr    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _tmp_dest_addr    PUSH_I8 2    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _tmp_dest_addr    PUSH_I8 4    ADD    LOAD_LOCAL _tmp_len    POKE2    ADDR_OF_GLOBAL mod_size    LOAD_GLOBAL num_mods    SHL1_ADD    PUSH_0    POKE2    ADDR_OF_GLOBAL mod_name    LOAD_GLOBAL num_mods    PUSH_I8 6    MUL    ADD    STORE_LOCAL _tmp_dest_addr    PUSH_STR ""    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _tmp_dest_addr    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _tmp_dest_addr    PUSH_I8 2    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _tmp_dest_addr    PUSH_I8 4    ADD    LOAD_LOCAL _tmp_len    POKE2    ADDR_OF_GLOBAL mod_exec_off    LOAD_GLOBAL num_mods    SHL1_ADD    PUSH_0    POKE2    LOAD_GLOBAL num_mods    PUSH_1    ADD    STORE_GLOBAL num_mods    RET_VOID.endfunction; ----------------------------------------------------; Function: print_hex4; ----------------------------------------------------.function print_hex4    .param v: word    .local hex: slice    .local idx: word    .local _pbuf: word    .local _tmp_base: word    .local _tmp_cap: word    .local _tmp_len: word    .local _tmp_addr: word    .local _tmp_dest_addr: word    PUSH_STR "0123456789ABCDEF"    STORE_LOCAL hex    LOAD_LOCAL v    PUSH_I8 15    BIT_AND    STORE_LOCAL idx    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    LOAD_LOCAL idx    LOAD_LOCAL idx    PUSH_1    ADD    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL hex    LOAD_LOCAL _tmp_base    LOAD_LOCAL _tmp_cap    SLICE_SUB    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    