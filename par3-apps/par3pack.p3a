; Global Variable Table.global io_buf: 256.global hex_chars: 16; ----------------------------------------------------; Function: init_hex; ----------------------------------------------------.function init_hex    .local _pbuf: word    .local _tmp_base: word    .local _tmp_cap: word    .local _tmp_len: word    .local _tmp_addr: word    .local _tmp_dest_addr: word    ADDR_OF_GLOBAL hex_chars    PUSH_0    ADD    PUSH_I8 48    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_1    ADD    PUSH_I8 49    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 2    ADD    PUSH_I8 50    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 3    ADD    PUSH_I8 51    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 4    ADD    PUSH_I8 52    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 5    ADD    PUSH_I8 53    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 6    ADD    PUSH_I8 54    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 7    ADD    PUSH_I8 55    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 8    ADD    PUSH_I8 56    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 9    ADD    PUSH_I8 57    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 10    ADD    PUSH_I8 65    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 11    ADD    PUSH_I8 66    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 12    ADD    PUSH_I8 67    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 13    ADD    PUSH_I8 68    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 14    ADD    PUSH_I8 69    POKE1    ADDR_OF_GLOBAL hex_chars    PUSH_I8 15    ADD    PUSH_I8 70    POKE1    RET_VOID.endfunction; ----------------------------------------------------; Function: path_join; ----------------------------------------------------.function path_join    .param dir: slice    .param file: slice    .local need_slash: word    .local total: word    .local p: word    .local off: word    .local i: word    .local _pbuf: word    .local _tmp_base: word    .local _tmp_cap: word    .local _tmp_len: word    .local _tmp_addr: word    .local _tmp_dest_addr: word    LOAD_LOCAL dir    SLICE_LEN    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_1    LOAD_LOCAL file    RET_SLICE.L_1:    PUSH_FALSE    STORE_LOCAL need_slash    LOAD_LOCAL dir    SLICE_LEN    PUSH_1    SUB    ADDR_OF_LOCAL dir    PEEK2    SWAP    ADD    PEEK1    PUSH_I8 47    CMP_NE    JUMP_IF_FALSE .L_3    PUSH_TRUE    STORE_LOCAL need_slash.L_3:    LOAD_LOCAL dir    SLICE_LEN    LOAD_LOCAL file    SLICE_LEN    ADD    STORE_LOCAL total    LOAD_LOCAL need_slash    JUMP_IF_FALSE .L_5    LOAD_LOCAL total    PUSH_1    ADD    STORE_LOCAL total.L_5:    LOAD_LOCAL total    BUF_ALLOC    STORE_LOCAL p    PUSH_0    STORE_LOCAL off    PUSH_0    STORE_LOCAL i.L_7:    LOAD_LOCAL i    LOAD_LOCAL dir    SLICE_LEN    CMP_LT    JUMP_IF_FALSE .L_9    JUMP .L_10.L_8:    LOAD_LOCAL i    PUSH_1    ADD    STORE_LOCAL i    JUMP .L_7.L_10:    LOAD_LOCAL p    LOAD_LOCAL off    ADD    LOAD_LOCAL i    ADDR_OF_LOCAL dir    PEEK2    SWAP    ADD    PEEK1    POKE1    LOAD_LOCAL off    PUSH_1    ADD    STORE_LOCAL off    JUMP .L_8.L_9:    LOAD_LOCAL need_slash    JUMP_IF_FALSE .L_11    LOAD_LOCAL p    LOAD_LOCAL off    ADD    PUSH_I8 47    POKE1    LOAD_LOCAL off    PUSH_1    ADD    STORE_LOCAL off.L_11:    PUSH_0    STORE_LOCAL i.L_13:    LOAD_LOCAL i    LOAD_LOCAL file    SLICE_LEN    CMP_LT    JUMP_IF_FALSE .L_15    JUMP .L_16.L_14:    LOAD_LOCAL i    PUSH_1    ADD    STORE_LOCAL i    JUMP .L_13.L_16:    LOAD_LOCAL p    LOAD_LOCAL off    ADD    LOAD_LOCAL i    ADDR_OF_LOCAL file    PEEK2    SWAP    ADD    PEEK1    POKE1    LOAD_LOCAL off    PUSH_1    ADD    STORE_LOCAL off    JUMP .L_14.L_15:    LOAD_LOCAL p    LOAD_LOCAL total    LOAD_LOCAL total    SLICE_NEW    RET_SLICE    RET_VOID.endfunction; ----------------------------------------------------; Function: write_str; ----------------------------------------------------.function write_str    .param h: word    .param s: slice    .local _pbuf: word    .local _tmp_base: word    .local _tmp_cap: word    .local _tmp_len: word    .local _tmp_addr: word    .local _tmp_dest_addr: word    LOAD_LOCAL s    SLICE_LEN    PUSH_0    CMP_GT    JUMP_IF_FALSE .L_17    LOAD_LOCAL h    LOAD_LOCAL s    POP    POP    LOAD_LOCAL s    SLICE_LEN    FILE_WRITE_BUF    POP.L_17:    RET_VOID.endfunction; ----------------------------------------------------; Function: main; ----------------------------------------------------.function main entry    .local args: slice    .local in_path: slice    .local modname: slice    .local out_dir: slice    .local mod_path: slice    .local mh: word    .local mok: word    .local ih: word    .local iok: word    .local pay_path: slice    .local ph: word    .local pok: word    .local line_buf: word    .local col: word    .local n: word    .local i: word    .local b: word    .local pfx: slice    .local j: word    .local _pbuf: word    .local _tmp_base: word    .local _tmp_cap: word    .local _tmp_len: word    .local _tmp_addr: word    .local _tmp_dest_addr: word    CALL init_hex    SYS_ARGS    STORE_LOCAL args    LOAD_LOCAL args    SLICE_LEN    PUSH_I8 2    CMP_LT    JUMP_IF_FALSE .L_19    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    PUSH_STR "Usage: par3pack <input.p3p> <modname> [out_dir]"    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINTLN    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_1    SYS_EXIT.L_19:    LOAD_LOCAL args    PUSH_0    GET_ARG    STORE_LOCAL in_path    LOAD_LOCAL args    PUSH_1    GET_ARG    STORE_LOCAL modname    PUSH_STR ""    STORE_LOCAL out_dir    LOAD_LOCAL args    SLICE_LEN    PUSH_I8 3    CMP_GE    JUMP_IF_FALSE .L_21    LOAD_LOCAL args    PUSH_I8 2    GET_ARG    STORE_LOCAL out_dir.L_21:    LOAD_LOCAL out_dir    PUSH_STR "modname.asm"    CALL path_join    STORE_LOCAL mod_path    LOAD_LOCAL mod_path    FILE_OPEN_WRITE    STORE_LOCAL mok    STORE_LOCAL mh    LOAD_LOCAL mok    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_23    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    PUSH_STR "ERROR: Cannot open "    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINT    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    LOAD_LOCAL mod_path    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINTLN    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_1    SYS_EXIT.L_23:    LOAD_LOCAL mh    PUSH_STR "        fcs     /"    CALL write_str    LOAD_LOCAL mh    LOAD_LOCAL modname    CALL write_str    LOAD_LOCAL mh    PUSH_STR "/\r"    CALL write_str    LOAD_LOCAL mh    FILE_CLOSE    LOAD_LOCAL in_path    FILE_OPEN_READ    STORE_LOCAL iok    STORE_LOCAL ih    LOAD_LOCAL iok    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_25    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    PUSH_STR "ERROR: Cannot open "    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINT    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    LOAD_LOCAL in_path    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINTLN    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_1    SYS_EXIT.L_25:    LOAD_LOCAL out_dir    PUSH_STR "payload.asm"    CALL path_join    STORE_LOCAL pay_path    LOAD_LOCAL pay_path    FILE_OPEN_WRITE    STORE_LOCAL pok    STORE_LOCAL ph    LOAD_LOCAL pok    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_27    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    PUSH_STR "ERROR: Cannot open "    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINT    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    LOAD_LOCAL pay_path    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINTLN    LOAD_LOCAL _pbuf    BUF_FREE    LOAD_LOCAL ih    FILE_CLOSE    PUSH_1    SYS_EXIT.L_27:    PUSH_I16 128    BUF_ALLOC    STORE_LOCAL line_buf    PUSH_0    STORE_LOCAL col.L_29:    LOAD_LOCAL ih    ADDR_OF_GLOBAL io_buf    PUSH_0    ADD    PUSH_I16 256    FILE_READ    STORE_LOCAL n    LOAD_LOCAL n    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_32    JUMP .L_31.L_32:    PUSH_0    STORE_LOCAL i.L_34:    LOAD_LOCAL i    LOAD_LOCAL n    CMP_LT    JUMP_IF_FALSE .L_36    JUMP .L_37.L_35:    LOAD_LOCAL i    PUSH_1    ADD    STORE_LOCAL i    JUMP .L_34.L_37:    LOAD_LOCAL i    ADDR_OF_GLOBAL io_buf    SWAP    ADD    PEEK1    STORE_LOCAL b    LOAD_LOCAL col    PUSH_0    CMP_EQ    JUMP_IF_FALSE .L_38    PUSH_STR "        fcb     "    STORE_LOCAL pfx    PUSH_0    STORE_LOCAL j.L_40:    LOAD_LOCAL j    LOAD_LOCAL pfx    SLICE_LEN    CMP_LT    JUMP_IF_FALSE .L_42    JUMP .L_43.L_41:    LOAD_LOCAL j    PUSH_1    ADD    STORE_LOCAL j    JUMP .L_40.L_43:    LOAD_LOCAL line_buf    LOAD_LOCAL j    ADD    LOAD_LOCAL j    ADDR_OF_LOCAL pfx    PEEK2    SWAP    ADD    PEEK1    POKE1    JUMP .L_41.L_42:    LOAD_LOCAL line_buf    PUSH_I8 16    ADD    PUSH_I8 36    POKE1    LOAD_LOCAL line_buf    PUSH_I8 17    ADD    LOAD_LOCAL b    PUSH_I8 4    SHR    PUSH_I8 15    BIT_AND    ADDR_OF_GLOBAL hex_chars    SWAP    ADD    PEEK1    POKE1    LOAD_LOCAL line_buf    PUSH_I8 18    ADD    LOAD_LOCAL b    PUSH_I8 15    BIT_AND    ADDR_OF_GLOBAL hex_chars    SWAP    ADD    PEEK1    POKE1    PUSH_I8 19    STORE_LOCAL col    JUMP .L_39.L_38:    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    PUSH_I8 44    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    PUSH_I8 36    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    LOAD_LOCAL b    PUSH_I8 4    SHR    PUSH_I8 15    BIT_AND    ADDR_OF_GLOBAL hex_chars    SWAP    ADD    PEEK1    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    LOAD_LOCAL b    PUSH_I8 15    BIT_AND    ADDR_OF_GLOBAL hex_chars    SWAP    ADD    PEEK1    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col.L_39:    LOAD_LOCAL col    PUSH_I8 79    CMP_GE    JUMP_IF_FALSE .L_44    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    PUSH_I8 13    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col    LOAD_LOCAL ph    LOAD_LOCAL line_buf    LOAD_LOCAL col    FILE_WRITE_BUF    POP    PUSH_0    STORE_LOCAL col.L_44:    JUMP .L_35.L_36:    JUMP .L_29.L_31:    LOAD_LOCAL col    PUSH_0    CMP_GT    JUMP_IF_FALSE .L_46    LOAD_LOCAL line_buf    LOAD_LOCAL col    ADD    PUSH_I8 13    POKE1    LOAD_LOCAL col    PUSH_1    ADD    STORE_LOCAL col    LOAD_LOCAL ph    LOAD_LOCAL line_buf    LOAD_LOCAL col    FILE_WRITE_BUF    POP.L_46:    LOAD_LOCAL ih    FILE_CLOSE    LOAD_LOCAL ph    FILE_CLOSE    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    PUSH_STR "Generated modname.asm and payload.asm for "    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINT    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_I8 64    BUF_ALLOC    STORE_LOCAL _pbuf    LOAD_LOCAL modname    STORE_LOCAL _tmp_len    STORE_LOCAL _tmp_cap    STORE_LOCAL _tmp_base    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    LOAD_LOCAL _tmp_base    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 26    ADD    LOAD_LOCAL _tmp_cap    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 28    ADD    LOAD_LOCAL _tmp_len    POKE2    LOAD_LOCAL _pbuf    LOAD_LOCAL _pbuf    PUSH_I8 24    ADD    POKE2    LOAD_LOCAL _pbuf    PUSH_I8 2    ADD    PUSH_STR "string"    POP    POP    POKE2    LOAD_LOCAL _pbuf    PUSH_1    PUSH_1    PRINTLN    LOAD_LOCAL _pbuf    BUF_FREE    PUSH_0    SYS_EXIT    RET_VOID.endfunction