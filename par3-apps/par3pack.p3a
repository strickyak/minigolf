; n := word(0)
    PUSH_0
    STORE_LOCAL n
; for * != 0
.L_for_top_1:
    LOAD_LOCAL s
    PEEK1
    PUSH_0
    CMP_NE
    JUMP_IF_FALSE .L_for_exit_2
; n++
    LOAD_LOCAL n
    PUSH_1
    ADD
    STORE_LOCAL n
; s = *(word(s) + 1)
