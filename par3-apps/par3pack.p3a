; ====================================================================
; Function: path_join
; ====================================================================
.function path_join
    .param dir: slice
    .param file: slice
    .local need_slash: byte
    .local total: word
    .local p: word
    .local off: word
    .local i: word
    .local res: slice
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; if len(dir) == 0
    LOAD_LOCAL dir
    SLICE_LEN
    PUSH_0
    CMP_EQ
    JUMP_IF_FALSE .L_endif_3
; return file
    LOAD_LOCAL file
    RET_SLICE
.L_endif_3:
; need_slash := false
    PUSH_FALSE
    STORE_LOCAL need_slash
; if dir[...] != 47
    ADDR_OF_LOCAL dir
    PEEK2
    LOAD_LOCAL dir
    SLICE_LEN
    PUSH_1
    SUB
    ADD
    PEEK1
    PUSH_I8 47
    CMP_NE
    JUMP_IF_FALSE .L_endif_4
; need_slash = true
    PUSH_TRUE
    STORE_LOCAL need_slash
.L_endif_4:
; total := word(len(dir)) + word(len(file))
    LOAD_LOCAL dir
    SLICE_LEN
    LOAD_LOCAL file
    SLICE_LEN
    ADD
    STORE_LOCAL total
; if need_slash
    LOAD_LOCAL need_slash
    JUMP_IF_FALSE .L_endif_5
; total++
    LOAD_LOCAL total
    PUSH_1
    ADD
    STORE_LOCAL total
.L_endif_5:
; p := alloc(total)
    LOAD_LOCAL total
    BUF_ALLOC
    STORE_LOCAL p
; off := word(0)
    PUSH_0
    STORE_LOCAL off
; for <init>; <cond>; <inc>
; i := word(0)
    PUSH_0
    STORE_LOCAL i
.L_for3_top_6:
    LOAD_LOCAL i
    LOAD_LOCAL dir
    SLICE_LEN
    CMP_LT
    JUMP_IF_FALSE .L_for3_exit_8
; pokeb(p + off, dir[...])
    LOAD_LOCAL p
    LOAD_LOCAL off
    ADD
    ADDR_OF_LOCAL dir
    PEEK2
    LOAD_LOCAL i
    ADD
    PEEK1
    POKE1
; off++
    LOAD_LOCAL off
    PUSH_1
    ADD
    STORE_LOCAL off
.L_for3_cont_7:
; i++
    LOAD_LOCAL i
    PUSH_1
    ADD
    STORE_LOCAL i
    JUMP .L_for3_top_6
.L_for3_exit_8:
; if need_slash
    LOAD_LOCAL need_slash
    JUMP_IF_FALSE .L_endif_9
; pokeb(p + off, 47)
    LOAD_LOCAL p
    LOAD_LOCAL off
    ADD
    PUSH_I8 47
    POKE1
; off++
    LOAD_LOCAL off
    PUSH_1
    ADD
    STORE_LOCAL off
.L_endif_9:
; for <init>; <cond>; <inc>
; i := word(0)
    PUSH_0
    STORE_LOCAL i
.L_for3_top_10:
    LOAD_LOCAL i
    LOAD_LOCAL file
    SLICE_LEN
    CMP_LT
    JUMP_IF_FALSE .L_for3_exit_12
; pokeb(p + off, file[...])
    LOAD_LOCAL p
    LOAD_LOCAL off
    ADD
    ADDR_OF_LOCAL file
    PEEK2
    LOAD_LOCAL i
    ADD
    PEEK1
    POKE1
; off++
    LOAD_LOCAL off
    PUSH_1
    ADD
    STORE_LOCAL off
.L_for3_cont_11:
; i++
    LOAD_LOCAL i
    PUSH_1
    ADD
    STORE_LOCAL i
    JUMP .L_for3_top_10
.L_for3_exit_12:
; var res
; res.Base = p
    LOAD_LOCAL p
    ADDR_OF_LOCAL res
    SWAP
    POKE2
; res.Cap = total
    LOAD_LOCAL total
    ADDR_OF_LOCAL res
    PUSH_I16 2
    ADD
    SWAP
    POKE2
; res.Len = total
    LOAD_LOCAL total
    ADDR_OF_LOCAL res
    PUSH_I16 4
    ADD
    SWAP
    POKE2
; return res
    LOAD_LOCAL res
    RET_SLICE
    RET_VOID
.endfunction

; ====================================================================
; Function: get_arg
; ====================================================================
.function get_arg
    .param args_base: word
    .param idx: word
    .local addr: word
    .local res: slice
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; addr := args_base + idx * 6
    LOAD_LOCAL args_base
    LOAD_LOCAL idx
    PUSH_I8 6
    MUL
    ADD
    STORE_LOCAL addr
; var res
; res.Base = peek(addr)
    LOAD_LOCAL addr
    PEEK2
    ADDR_OF_LOCAL res
    SWAP
    POKE2
; res.Cap = peek(addr + 2)
    LOAD_LOCAL addr
    PUSH_I8 2
    ADD
    PEEK2
    ADDR_OF_LOCAL res
    PUSH_I16 2
    ADD
    SWAP
    POKE2
; res.Len = peek(addr + 4)
    LOAD_LOCAL addr
    PUSH_I8 4
    ADD
    PEEK2
    ADDR_OF_LOCAL res
    PUSH_I16 4
    ADD
    SWAP
    POKE2
; return res
    LOAD_LOCAL res
    RET_SLICE
    RET_VOID
.endfunction

; ====================================================================
; Function: write_str
