    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; if len(s) > 0
    LOAD_LOCAL s
    SLICE_LEN
    PUSH_0
    CMP_GT
    JUMP_IF_FALSE .L_endif_13
; file_write(h, s.Base, word(len(s)))
    LOAD_LOCAL h
    ADDR_OF_LOCAL s
    PEEK2
    LOAD_LOCAL s
    SLICE_LEN
    FILE_WRITE_BUF
    POP
.L_endif_13:
    RET_VOID
.endfunction

