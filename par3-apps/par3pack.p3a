; init_hex()
    CALL init_hex
; args := sys_args()
    SYS_ARGS
    STORE_LOCAL args
; if args.Len < 2
    ADDR_OF_LOCAL args
    PUSH_I16 4
    ADD
    PEEK2
    PUSH_I8 2
    CMP_LT
    JUMP_IF_FALSE .L_endif_14
; println("Usage: par3pack <input.p3p> <modname> [out_dir]")
; println("Usage: par3pack <input.p3p> <modname> [out_dir]")
    PUSH_I16 10
    BUF_ALLOC
    STORE_LOCAL _pbuf
    PUSH_STR "Usage: par3pack <input.p3p> <modname> [out_dir]"
    STORE_LOCAL _tmp_len
    STORE_LOCAL _tmp_cap
    STORE_LOCAL _tmp_base
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    LOAD_LOCAL _tmp_base
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 6
    ADD
    LOAD_LOCAL _tmp_cap
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 8
    ADD
    LOAD_LOCAL _tmp_len
    POKE2
    LOAD_LOCAL _pbuf
    LOAD_LOCAL _pbuf
    PUSH_I16 4
    ADD
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_I16 2
    ADD
    PUSH_STR "string"
    POP
    POP
    POKE2
    LOAD_LOCAL _pbuf
    PUSH_1
    PUSH_1
    PRINTLN
    LOAD_LOCAL _pbuf
    BUF_FREE
; sys_exit(1)
    PUSH_1
    SYS_EXIT
.L_endif_14:
; in_path := get_arg(args.Base, 0)
    ADDR_OF_LOCAL args
    PEEK2
    PUSH_0
    CALL get_arg
    STORE_LOCAL in_path
; modname := get_arg(args.Base, 1)
    ADDR_OF_LOCAL args
    PEEK2
    PUSH_1
    CALL get_arg
    STORE_LOCAL modname
; out_dir := ""
    PUSH_STR ""
    STORE_LOCAL out_dir
; if args.Len >= 3
    ADDR_OF_LOCAL args
    PUSH_I16 4
    ADD
    PEEK2
    PUSH_I8 3
    CMP_GE
    JUMP_IF_FALSE .L_endif_15
; out_dir = get_arg(args.Base, 2)
