; ====================================================================
; Function: find_global
; ====================================================================
.function find_global
    .param name: slice
    .local i: word
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; for <init>; <cond>; <inc>
; i := word(0)
    PUSH_0
    STORE_LOCAL i
.L_for3_top_264:
    LOAD_LOCAL i
    LOAD_GLOBAL num_globals
    CMP_LT
    JUMP_IF_FALSE .L_for3_exit_266
; if global_names[...] == name
    ADDR_OF_GLOBAL global_names
    LOAD_LOCAL i
    PUSH_I16 6
    MUL
    ADD
    STORE_LOCAL _tmp_addr
    LOAD_LOCAL _tmp_addr
    PEEK2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    PEEK2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    PEEK2
    LOAD_LOCAL name
    STR_CMP
    NOT
    JUMP_IF_FALSE .L_endif_267
; return i
    LOAD_LOCAL i
    RET
.L_endif_267:
.L_for3_cont_265:
; i++
    LOAD_LOCAL i
    PUSH_1
    ADD
    STORE_LOCAL i
    JUMP .L_for3_top_264
.L_for3_exit_266:
; return 65535
    PUSH_I16 65535
    RET
    RET_VOID
.endfunction

