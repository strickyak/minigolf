; ====================================================================
; Function: set_op
; ====================================================================
.function set_op
    .param idx: word
    .param name: slice
    .param op: byte
    .param arg_bytes: byte
    .param arg_type: byte
    .local _pbuf: word
    .local _tmp_base: word
    .local _tmp_cap: word
    .local _tmp_len: word
    .local _tmp_addr: word
    .local _swap_0: slice
    .local _swap_1: slice
    .local _swap_2: slice
    .local _swap_3: slice

; op_names[...] = name
    LOAD_LOCAL name
    ADDR_OF_GLOBAL op_names
    LOAD_LOCAL idx
    PUSH_I16 6
    MUL
    ADD
    STORE_LOCAL _tmp_addr
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    SWAP
    POKE2
    LOAD_LOCAL _tmp_addr
    SWAP
    POKE2
; op_bytes[...] = op
    LOAD_LOCAL op
    ADDR_OF_GLOBAL op_bytes
    LOAD_LOCAL idx
    ADD
    SWAP
    POKE1
; op_arg_bytes[...] = arg_bytes
    LOAD_LOCAL arg_bytes
    ADDR_OF_GLOBAL op_arg_bytes
    LOAD_LOCAL idx
    ADD
    SWAP
    POKE1
; op_arg_types[...] = arg_type
    LOAD_LOCAL arg_type
    ADDR_OF_GLOBAL op_arg_types
    LOAD_LOCAL idx
    ADD
    SWAP
    POKE1
    RET_VOID
.endfunction

