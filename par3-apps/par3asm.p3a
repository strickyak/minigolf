    LOAD_LOCAL _tmp_addr
    PEEK2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 2
    ADD
    PEEK2
    LOAD_LOCAL _tmp_addr
    PUSH_I16 4
    ADD
    PEEK2
    STR_CMP
