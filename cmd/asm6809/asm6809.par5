package main

import "os"
import "shashmap"

// Addressing mode categories
const ModeInherent = 0
const ModeImm8 = 1
const ModeBranchShort = 2
const ModeBranchLong = 3
const ModeRegReg = 4
const ModeStack = 5
const ModeGeneral = 6

const NO_OP = 0xFFFF

type OpInfo struct {
	Mode      byte
	Imm       word
	Dir       word
	Idx       word
	Ext       word
	Inh       word
	Imm16     byte
	RelOpcode word
	LongRelOp word
}

type Statement struct {
	LineNum        word
	RawLine        string
	Label          string
	Op             string
	Operand        string
	PCHi           word
	PC             word
	Size           word
	B0             byte
	B1             byte
	B2             byte
	B3             byte
	B4             byte
	ExtraBytes     slice[byte]
	IsShortBranch  byte
	ForceMode      byte // 0=none, 1='<', 2='>'
	IsDirective    byte
	IsCommentOnly  byte
	HasOrg         byte
	OrgHi          word
	OrgAddr        word
	HasEndAddr     byte
	EndAddr        word
}

// Hash tables for fast lookup and large capacity in Far Data
var opMap shashmap.SHashMap[OpInfo]
var symMap shashmap.SHashMap[word]
var equMap shashmap.SHashMap[string]
var equBusyMap shashmap.SHashMap[byte]

// Paged statement storage in Far Data (64 statements per page, up to 64 pages = 4096 statements)
var stmtPages [64]slice[Statement]
var numStmtPages word
var numStmts word

// Assembler state
var dpReg byte
var cEscapes bool
var enableRelax bool
var hasExecAddr bool
var hasCstart bool
var execAddr word
var lastGlobalLabel string
var keepRawLines bool
var asmErr string

// OS-9 Module state
var hasMod bool
var modStartStmtIdx word
var os9Mode bool
var os9Name string
var os9Mem word
var os9Rev byte
var os9Attr byte
var os9Tylg byte
var os9Edition byte
var namTitle string
var inDataOrg bool
var dataPC word

func setError(msg string) {
	if asmErr.Len == 0 {
		asmErr = msg
	}
}

func addOp(name string, mode byte, imm word, dir word, idx word, ext word, inh word, imm16 byte, relOp word, longRelOp word) {
	var info OpInfo
	info.Mode = mode
	info.Imm = imm
	info.Dir = dir
	info.Idx = idx
	info.Ext = ext
	info.Inh = inh
	info.Imm16 = imm16
	info.RelOpcode = relOp
	info.LongRelOp = longRelOp
	opMap.Insert(name, info)
}

func lookupOp(name string) (OpInfo, bool) {
	return opMap.Lookup(name)
}

func symSet(name string, val word) {
	symMap.Insert(name, val)
}

func symGet(name string) (word, bool) {
	return symMap.Lookup(name)
}

func equSet(name string, expr string) {
	equMap.Insert(name, expr)
}

func equGet(name string) (string, bool) {
	return equMap.Lookup(name)
}

func addStmt(s Statement) {
	pageIdx := numStmts >> 6
	offIdx := numStmts & 63
	if pageIdx >= numStmtPages {
		page := FarMakeSlice[Statement](64)
		page.Len = 64
		stmtPages[numStmtPages] = page
		numStmtPages++
	}
	p := stmtPages[pageIdx]
	p.Put(offIdx, s)
	numStmts++
}

func getStmt(i word) Statement {
	p := stmtPages[i>>6]
	return p.Get(i & 63)
}

func setStmt(i word, s Statement) {
	p := stmtPages[i>>6]
	p.Put(i&63, s)
}

func stmtClearBytes(s *Statement) {
	s.Size = 0
	s.ExtraBytes.Len = 0
}

func stmtAddByte(s *Statement, b byte) {
	idx := s.Size
	if idx == 0 {
		s.B0 = b
	} else if idx == 1 {
		s.B1 = b
	} else if idx == 2 {
		s.B2 = b
	} else if idx == 3 {
		s.B3 = b
	} else if idx == 4 {
		s.B4 = b
	} else {
		if idx == 5 {
			s.ExtraBytes.Len = 0
			s.ExtraBytes.Append(s.B0)
			s.ExtraBytes.Append(s.B1)
			s.ExtraBytes.Append(s.B2)
			s.ExtraBytes.Append(s.B3)
			s.ExtraBytes.Append(s.B4)
		}
		s.ExtraBytes.Append(b)
	}
	s.Size = idx + 1
}

func stmtAddWord(s *Statement, w word) {
	stmtAddByte(s, byte(w>>8))
	stmtAddByte(s, byte(w))
}

func stmtAddOpcode(s *Statement, op word) {
	if op > 0xFF {
		stmtAddByte(s, byte(op>>8))
		stmtAddByte(s, byte(op))
	} else {
		stmtAddByte(s, byte(op))
	}
}

func stmtGetByte(s *Statement, idx word) byte {
	if s.Size > 5 {
		return s.ExtraBytes.Get(idx)
	}
	if idx == 0 {
		return s.B0
	}
	if idx == 1 {
		return s.B1
	}
	if idx == 2 {
		return s.B2
	}
	if idx == 3 {
		return s.B3
	}
	return s.B4
}

func opcodeSize(op word) word {
	if op > 0xFF {
		return 2
	}
	return 1
}

func addInhOp(name string, inh word) {
	addOp(name, ModeInherent, NO_OP, NO_OP, NO_OP, NO_OP, inh, 0, NO_OP, NO_OP)
}

func addBranchOp(name string, mode byte, relOp word, longRelOp word) {
	addOp(name, mode, NO_OP, NO_OP, NO_OP, NO_OP, NO_OP, 0, relOp, longRelOp)
}

func addMemOp(name string, dir word, idx word, ext word) {
	addOp(name, ModeGeneral, NO_OP, dir, idx, ext, NO_OP, 0, NO_OP, NO_OP)
}

func addAlu8Op(name string, imm word, dir word, idx word, ext word) {
	addOp(name, ModeGeneral, imm, dir, idx, ext, NO_OP, 0, NO_OP, NO_OP)
}

func addAlu16Op(name string, imm word, dir word, idx word, ext word, imm16 byte) {
	addOp(name, ModeGeneral, imm, dir, idx, ext, NO_OP, imm16, NO_OP, NO_OP)
}

