--- Sizeof ---
sizeof: 4
--- Constants and Conversions ---
zero: 0 1
one: 1
w42: 42 42
wMax: 65535 65535
iNeg1: -1
iNeg42: -42
--- FromString and Format ---
s1: 123456789
sNeg1: -987654321
maxPos: 2147483647
minNeg: -2147483648
--- Addition ---
1000000 + 2345678 = 3345678
5 + (-3) = 2
(-5) + 3 = -2
(-5) + (-3) = -8
5 + (-5) = 0
maxPos + 1 = -2147483648
method a.Add(b) = 3345678
--- Subtraction ---
2345678 - 1000000 = 1345678
1000000 - 2345678 = -1345678
5 - (-3) = 8
(-5) - 3 = -8
(-5) - (-3) = -2
minNeg - 1 = 2147483647
method b.Sub(a) = 1345678
--- Multiplication ---
6 * 7 = 42
(-6) * 7 = -42
(-6) * (-7) = 42
100000 * 20000 = 2000000000
method n6.Mul(n7) = 42
--- Division and Modulo ---
100 / 7 = 14
100 % 7 = 2
(-100) / 7 = -14
(-100) % 7 = -2
100 / (-7) = -14
100 % (-7) = 2
(-100) / (-7) = 14
(-100) % (-7) = -2
2000000000 / 100000 = 20000
2000000000 % 100000 = 0
minNeg / 2 = -1073741824
method n100.Div(n7) = 14
method n100.Mod(n7) = 2
--- Comparisons ---
5 < 7: 1
7 < 5: 0
5 == 5: 1
(-5) < 3: 1
3 < (-5): 0
(-5) < (-3): 1
(-3) < (-5): 0
minNeg < maxPos: 1
maxPos < minNeg: 0
--- Bitwise Ops and Shifts ---
and: 983280
or: 268374015
xor: 267390735
1000 << 3 = 8000
1000 >> 3 = 125
(-1000) >> 3 = -125
