package main

func testByte(b byte) word {
	var r word
	switch b {
	case 1:
		r = 10
	case 2, 3:
		r = 20
	case 4:
		r = 40
		break
		r = 999
	default:
		r = 100
	}
	return r
}

func testWord(w word) word {
	var r word
	switch w {
	default:
		r = 999
	case 100:
		r = 1
	case 200, 300:
		r = 2
	case 400:
		r = 4
	}
	return r
}

func testNoDefault(b byte) word {
	var r word = 55
	switch b {
	case 1:
		r = 111
	case 2:
		r = 222
	}
	return r
}

func testEmptyCase(b byte) word {
	var r word = 77
	switch b {
	case 1:
		// empty body
	case 2:
		r = 88
	default:
		r = 99
	}
	return r
}

func testInt(i int) word {
	var r word
	switch i {
	case -100:
		r = 1
	case -1, 0:
		r = 2
	case 42:
		r = 3
	default:
		r = 99
	}
	return r
}

const GREET = "hello"

func testString(s string) word {
	var r word
	switch s {
	case GREET:
		r = 1
	case "world":
		r = 2
	case "he", "hell":
		r = 3
	case "hello world":
		r = 4
	default:
		r = 100
	}
	return r
}

func testSliceByte(s slice[byte]) word {
	var r word = 50
	switch s {
	case "foo":
		r = 500
	case "bar":
		r = 600
	}
	return r
}

func testNoArg(x int) word {
	var r word
	switch {
	case x < 0:
		r = 1
	case x == 0:
		r = 2
	case x == 10, x == 20:
		r = 3
	default:
		r = 4
	}
	return r
}

func testNoArgNoDefault(x word) word {
	var r word = 777
	switch {
	case x == 1:
		r = 11
	case x == 2:
		r = 22
	}
	return r
}

var evalOrder word

func check(n word, ret bool) bool {
	evalOrder = evalOrder*10 + n
	return ret
}

func testOrder(pick word) word {
	evalOrder = 0
	var r word
	switch {
	case check(1, pick == 1):
		r = 100
	case check(2, pick == 2), check(3, pick == 3):
		r = 200
	default:
		r = 300
	}
	return r
}

func main() {
	println(testByte(1))
	println(testByte(2))
	println(testByte(3))
	println(testByte(4))
	println(testByte(5))

	println(testWord(100))
	println(testWord(200))
	println(testWord(300))
	println(testWord(400))
	println(testWord(500))

	println(testNoDefault(1))
	println(testNoDefault(2))
	println(testNoDefault(3))

	println(testEmptyCase(1))
	println(testEmptyCase(2))
	println(testEmptyCase(3))

	println(testInt(-100))
	println(testInt(-1))
	println(testInt(0))
	println(testInt(42))
	println(testInt(999))

	println(testString("hello"))
	println(testString("world"))
	println(testString("he"))
	println(testString("hell"))
	println(testString("hello world"))
	println(testString("other"))
	println(testString("hellow"))

	println(testSliceByte("foo"))
	println(testSliceByte("bar"))
	println(testSliceByte("baz"))

	println(testNoArg(-5))
	println(testNoArg(0))
	println(testNoArg(10))
	println(testNoArg(20))
	println(testNoArg(99))

	println(testNoArgNoDefault(1))
	println(testNoArgNoDefault(2))
	println(testNoArgNoDefault(3))

	println(testOrder(1))
	println(evalOrder)
	println(testOrder(2))
	println(evalOrder)
	println(testOrder(3))
	println(evalOrder)
	println(testOrder(99))
	println(evalOrder)
}
