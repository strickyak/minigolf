--- Sizeof ---
sizeof: 8
--- Constants and Conversions ---
zero: 0 1
one: 1
w42: 42 42
wMax: 65535 65535
iNeg1: -1
iNeg42: -42
fromLong: 2000000000
fromLongNeg: -2000000000
toLong: 2000000000
toLongNeg: -2000000000
--- FromString and Format ---
s1: 123456789012345678
sNeg1: -987654321098765432
maxPos: 9223372036854775807
minNeg: -9223372036854775808
--- Addition ---
1000000000000 + 2345678000000 = 3345678000000
5 + (-3) = 2
(-5) + 3 = -2
(-5) + (-3) = -8
5 + (-5) = 0
maxPos + 1 = -9223372036854775808
method a.Add(b) = 3345678000000
--- Subtraction ---
2345678000000 - 1000000000000 = 1345678000000
1000000000000 - 2345678000000 = -1345678000000
5 - (-3) = 8
(-5) - 3 = -8
(-5) - (-3) = -2
minNeg - 1 = 9223372036854775807
method b.Sub(a) = 1345678000000
--- Multiplication ---
6 * 7 = 42
(-6) * 7 = -42
(-6) * (-7) = 42
1000000000 * 3000000000 = 3000000000000000000
method n6.Mul(n7) = 42
--- Division and Modulo ---
100 / 7 = 14
100 % 7 = 2
(-100) / 7 = -14
(-100) % 7 = -2
100 / (-7) = -14
100 % (-7) = 2
(-100) / (-7) = 14
(-100) % (-7) = -2
3 * 10^18 / 10^9 = 3000000000
3 * 10^18 % 10^9 = 0
minNeg / 2 = -4611686018427387904
method n100.Div(n7) = 14
method n100.Mod(n7) = 2
--- Comparisons ---
5 < 7: 1
7 < 5: 0
5 == 5: 1
(-5) < 3: 1
3 < (-5): 0
(-5) < (-3): 1
(-3) < (-5): 0
minNeg < maxPos: 1
maxPos < minNeg: 0
