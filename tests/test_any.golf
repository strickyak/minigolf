package main

import "printany"

import "pre2"

func main() {
	printany.printany(byte(88))
	printany.printany(word(888))
	printany.printany("hello")

	worldBase := "world".Base
	worldBasePtr := (*byte)(worldBase)
	printany.printany(worldBasePtr) /* bug */

	s := "one two three"
	pre2.printany2(s[0])
	pre2.printany2(s[1])
	pre2.printany2(s[2])
	pre2.printany2(s[0:3])
	pre2.printany2(s[4:7])
	pre2.printany2(s[8:13])
}
